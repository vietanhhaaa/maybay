    function buildAirplaneModel() {
        const root = airplane.meshRoot;
        // Máy bay hướng dọc theo trục +X trong hệ tọa độ cục bộ?
        // Quy ước chuẩn Three.js: Mũi máy bay hướng về -Z (Forward = (0, 0, -1)), cánh trải ngang trục X, trục Y hướng lên.
        const bodyMat = new THREE.MeshStandardMaterial({
            color: 0xe2e8f0,
            roughness: 0.28,
            metalness: 0.65
        });
        const darkMat = new THREE.MeshStandardMaterial({
            color: 0x1e293b,
            roughness: 0.45,
            metalness: 0.55
        });
        const accentMat = new THREE.MeshStandardMaterial({
            color: 0x0284c7,
            roughness: 0.3,
            metalness: 0.5
        });
        const glassMat = new THREE.MeshStandardMaterial({
            color: 0x38bdf8,
            roughness: 0.08,
            metalness: 0.9,
            transparent: true,
            opacity: 0.65
        });

        // 1. Thân chính (Fuselage) và mũi khí động học (Nose Cone)
        const fuselage = new THREE.Mesh(new THREE.CylinderGeometry(0.95, 1.15, 11.5, 16), bodyMat);
        fuselage.rotation.x = Math.PI / 2;
        fuselage.castShadow = true;
        root.add(fuselage);

        const nose = new THREE.Mesh(new THREE.ConeGeometry(0.95, 4.4, 16), darkMat);
        nose.rotation.x = -Math.PI / 2;
        nose.position.set(0, -0.04, -7.95);
        nose.castShadow = true;
        root.add(nose);

        // Buồng lái kính vòm (Canopy)
        const canopy = new THREE.Mesh(new THREE.SphereGeometry(0.86, 16, 12), glassMat);
        canopy.scale.set(0.88, 0.72, 2.75);
        canopy.position.set(0, 0.68, -2.5);
        root.add(canopy);

        // Hai ống hút gió động cơ hai bên thân (Side Intakes)
        for (let side of [-1, 1]) {
            const intake = new THREE.Mesh(new THREE.BoxGeometry(0.75, 0.85, 6.8), bodyMat);
            intake.position.set(side * 1.12, -0.08, 0.6);
            intake.castShadow = true;
            root.add(intake);

            // Ống xả phản lực kép phía đuôi (Exhaust Nozzles)
            const nozzle = new THREE.Mesh(new THREE.CylinderGeometry(0.48, 0.58, 1.4, 14), darkMat);
            nozzle.rotation.x = Math.PI / 2;
            nozzle.position.set(side * 0.62, -0.05, 6.2);
            root.add(nozzle);
        }

        // 2. Cánh chính xuôi sau (Swept Main Wings)
        const wingShape = new THREE.Shape();
        wingShape.moveTo(0, -2.2);
        wingShape.lineTo(8.4, 1.1);
        wingShape.lineTo(8.4, 2.3);
        wingShape.lineTo(0, 2.6);
        wingShape.closePath();

        const extrudeSettings = { depth: 0.16, bevelEnabled: true, bevelThickness: 0.04, bevelSize: 0.04, bevelSegments: 2 };
        const rightWingGeo = new THREE.ExtrudeGeometry(wingShape, extrudeSettings);
        rightWingGeo.rotateX(Math.PI / 2);
        const rightWing = new THREE.Mesh(rightWingGeo, bodyMat);
        rightWing.position.set(0, 0.08, 0);
        rightWing.castShadow = true;
        rightWing.receiveShadow = true;
        root.add(rightWing);

        const leftWing = rightWing.clone();
        leftWing.scale.x = -1;
        root.add(leftWing);

        // Thanh treo tên lửa / đầu cánh (Wingtip Rails)
        for (let side of [-1, 1]) {
            const rail = new THREE.Mesh(new THREE.CylinderGeometry(0.08, 0.08, 2.2, 8), accentMat);
            rail.rotation.x = Math.PI / 2;
            rail.position.set(side * 8.42, 0.02, 1.55);
            root.add(rail);
        }

        // 3. Các mặt điều khiển bay chuyển động (Ailerons, Flaps, Elevators, Rudders)
        const ctrlGeo = new THREE.BoxGeometry(2.3, 0.08, 0.55);
        airplane.leftAileron = new THREE.Mesh(ctrlGeo, accentMat);
        airplane.leftAileron.position.set(-6.5, 0.0, 2.35);
        root.add(airplane.leftAileron);

        airplane.rightAileron = new THREE.Mesh(ctrlGeo, accentMat);
        airplane.rightAileron.position.set(6.5, 0.0, 2.35);
        root.add(airplane.rightAileron);

        const flapGeo = new THREE.BoxGeometry(2.6, 0.09, 0.65);
        airplane.leftFlap = new THREE.Mesh(flapGeo, darkMat);
        airplane.leftFlap.position.set(-3.2, -0.02, 2.55);
        root.add(airplane.leftFlap);

        airplane.rightFlap = new THREE.Mesh(flapGeo, darkMat);
        airplane.rightFlap.position.set(3.2, -0.02, 2.55);
        root.add(airplane.rightFlap);

        // Cánh đuôi ngang (Elevators)
        const elevGeo = new THREE.BoxGeometry(2.8, 0.1, 1.35);
        airplane.leftElevator = new THREE.Mesh(elevGeo, bodyMat);
        airplane.leftElevator.position.set(-2.3, 0.0, 5.25);
        root.add(airplane.leftElevator);

        airplane.rightElevator = new THREE.Mesh(elevGeo, bodyMat);
        airplane.rightElevator.position.set(2.3, 0.0, 5.25);
        root.add(airplane.rightElevator);

        // Cánh đuôi đứng kép nghiêng chữ V (Twin Vertical Stabilizers & Rudders)
        for (let side of [-1, 1]) {
            const vTail = new THREE.Mesh(new THREE.BoxGeometry(0.14, 2.65, 2.4), bodyMat);
            vTail.position.set(side * 1.15, 1.25, 4.7);
            vTail.rotation.z = -side * 0.22;
            vTail.castShadow = true;
            root.add(vTail);

            const rudder = new THREE.Mesh(new THREE.BoxGeometry(0.12, 2.2, 0.55), accentMat);
            rudder.position.set(side * 1.22, 1.22, 5.95);
            rudder.rotation.z = -side * 0.22;
            root.add(rudder);
            if (side < 0) airplane.leftRudder = rudder;
            else airplane.rightRudder = rudder;
        }

        // 4. Lửa động cơ đốt sau (Afterburner Cones)
        const abGeo = new THREE.ConeGeometry(0.45, 3.6, 12, 1, true);
        abGeo.rotateX(Math.PI / 2);
        abGeo.translate(0, 0, 1.8);
        const abMat = new THREE.MeshBasicMaterial({
            color: 0x38bdf8,
            transparent: true,
            opacity: 0.85,
            blending: THREE.AdditiveBlending,
            side: THREE.DoubleSide,
            depthWrite: false
        });
        airplane.afterburnerL = new THREE.Mesh(abGeo, abMat);
        airplane.afterburnerL.position.set(-0.62, -0.05, 6.8);
        root.add(airplane.afterburnerL);

        airplane.afterburnerR = new THREE.Mesh(abGeo, abMat.clone());
        airplane.afterburnerR.position.set(0.62, -0.05, 6.8);
        root.add(airplane.afterburnerR);

        // 5. Bộ bánh đáp 3 càng có thể thu/thả (Retractable Tricycle Landing Gear)
        const strutMat = new THREE.MeshStandardMaterial({ color: 0xcbd5e1, metalness: 0.8, roughness: 0.2 });
        const tireMat = new THREE.MeshStandardMaterial({ color: 0x111827, roughness: 0.9 });
        const wheelGeo = new THREE.CylinderGeometry(0.38, 0.38, 0.26, 12);
        wheelGeo.rotateZ(Math.PI / 2);

        // Càng mũi (Nose Gear)
        const noseStrut = new THREE.Mesh(new THREE.CylinderGeometry(0.08, 0.08, 1.45, 8), strutMat);
        noseStrut.position.set(0, -0.95, -4.5);
        airplane.gearGroup.add(noseStrut);
        const noseWheel = new THREE.Mesh(wheelGeo, tireMat);
        noseWheel.position.set(0, -1.65, -4.5);
        airplane.gearGroup.add(noseWheel);

        // Hai càng chính (Main Gears)
        for (let side of [-1, 1]) {
            const mStrut = new THREE.Mesh(new THREE.CylinderGeometry(0.1, 0.1, 1.5, 8), strutMat);
            mStrut.position.set(side * 1.65, -0.95, 0.85);
            airplane.gearGroup.add(mStrut);

            const mWheel = new THREE.Mesh(wheelGeo, tireMat);
            mWheel.scale.set(1.2, 1.2, 1.2);
            mWheel.position.set(side * 1.75, -1.65, 0.85);
            airplane.gearGroup.add(mWheel);
        }
        root.add(airplane.gearGroup);

        // 6. Đèn hàng không (Navigation Lights: Đỏ trái, Xanh phải, Chớp trắng & Đèn pha hạ cánh)
        const navSphere = new THREE.SphereGeometry(0.16, 8, 8);
        const redNav = new THREE.Mesh(navSphere, new THREE.MeshBasicMaterial({ color: 0xff2222 }));
        redNav.position.set(-8.45, 0.05, 1.2);
        root.add(redNav);

        const greenNav = new THREE.Mesh(navSphere, new THREE.MeshBasicMaterial({ color: 0x22ff55 }));
        greenNav.position.set(8.45, 0.05, 1.2);
        root.add(greenNav);

        airplane.strobeLight = new THREE.PointLight(0xffffff, 0, 35);
        airplane.strobeLight.position.set(0, 2.6, 5.2);
        root.add(airplane.strobeLight);

        airplane.landingLight = new THREE.SpotLight(0xfffbeb, 0.0, 280, Math.PI / 5, 0.5, 1.2);
        airplane.landingLight.position.set(0, -1.2, -5.2);
        airplane.landingLight.target.position.set(0, -4.5, -65);
        root.add(airplane.landingLight);
        root.add(airplane.landingLight.target);

        airplane.group.add(root);
        scene.add(airplane.group);
    }

    // ============================================================================
    // 10. HỆ THỐNG HẠT (VỆT KHÓI ĐẦU CÁNH, BỤI HẠ CÁNH, VỤ NỔ & MẢNH VỠ)
    // ============================================================================
    const particles = [];
    let particleInstMesh = null;
    const MAX_PARTICLES = 450;

    function initParticleSystem() {
        const geo = new THREE.DodecahedronGeometry(1, 0);
        const mat = new THREE.MeshBasicMaterial({
            color: 0xffffff,
            transparent: true,
            opacity: 0.72
        });
        particleInstMesh = new THREE.InstancedMesh(geo, mat, MAX_PARTICLES);
        particleInstMesh.instanceMatrix.setUsage(THREE.DynamicDrawUsage);
        scene.add(particleInstMesh);

        const col = new THREE.Color(0xffffff);
        for (let i = 0; i < MAX_PARTICLES; i++) {
            particleInstMesh.setColorAt(i, col);
        }
    }

    function spawnParticle(pos, vel, scale, life, colorHex, affectedByGravity = true) {
        if (particles.length >= MAX_PARTICLES) particles.shift();
        particles.push({
            pos: pos.clone(),
            vel: vel.clone(),
            scale,
            maxScale: scale * 2.4,
            life,
            maxLife: life,
            color: new THREE.Color(colorHex),
            affectedByGravity
        });
    }

    function triggerCrashExplosion(pos) {
        sound.playExplosion();
        const fireColors = [0xff4500, 0xff8c00, 0xfacc15, 0xef4444, 0x334155, 0x1e293b];
        for (let i = 0; i < 95; i++) {
            const v = new THREE.Vector3(
                (Math.random() - 0.5) * 48,
                Math.random() * 36 + 6,
                (Math.random() - 0.5) * 48
            );
            const c = fireColors[Math.floor(Math.random() * fireColors.length)];
            spawnParticle(pos, v, 1.5 + Math.random() * 3.2, 1.4 + Math.random() * 1.8, c, true);
        }
    }

    function updateParticles(dt) {
        if (!particleInstMesh) return;
        const dummy = new THREE.Object3D();
        const gAccel = GAME.gravityG * CONFIG.gravityEarth;

        for (let i = particles.length - 1; i >= 0; i--) {
            const p = particles[i];
            p.life -= dt;
            if (p.life <= 0) {
                particles.splice(i, 1);
                continue;
            }
            if (p.affectedByGravity) {
                // Khói và mảnh vỡ chịu ảnh hưởng trực tiếp bởi trọng lực hiện tại!
                p.vel.y -= gAccel * 0.35 * dt;
            } else {
                // Vệt khói hơi nước nở nhẹ và chịu lực nổi ngược chiều trọng lực
                p.vel.y += gAccel * 0.08 * dt;
            }
            p.pos.addScaledVector(p.vel, dt);

            const groundY = getTerrainHeight(p.pos.x, p.pos.z) + 0.5;
            if (p.pos.y < groundY) {
                p.pos.y = groundY;
                p.vel.y *= -0.35;
                p.vel.x *= 0.7;
                p.vel.z *= 0.7;
            }
        }

        for (let i = 0; i < MAX_PARTICLES; i++) {
            if (i < particles.length) {
                const p = particles[i];
                const progress = 1.0 - p.life / p.maxLife;
                const s = MathUtils.lerp(p.scale, p.maxScale, progress) * (1.0 - progress * 0.65);
                dummy.position.copy(p.pos);
                dummy.scale.set(s, s, s);
                dummy.rotation.set(progress * 3, progress * 2, 0);
                dummy.updateMatrix();
                particleInstMesh.setMatrixAt(i, dummy.matrix);
                particleInstMesh.setColorAt(i, p.color);
            } else {
                dummy.position.set(0, -9999, 0);
                dummy.scale.set(0.001, 0.001, 0.001);
                dummy.updateMatrix();
                particleInstMesh.setMatrixAt(i, dummy.matrix);
            }
        }
        particleInstMesh.instanceMatrix.needsUpdate = true;
        if (particleInstMesh.instanceColor) particleInstMesh.instanceColor.needsUpdate = true;
    }

    // ============================================================================
    // 11. ĐIỀU KHIỂN BÀN PHÍM, CHUỘT & JOYSTICK CẢM ỨNG
    // ============================================================================
    const keys = {};
    const touchInput = { pitch: 0, roll: 0, thrUp: false, thrDown: false, active: false };
    let isDraggingOrbit = false;
    let prevMouseX = 0, prevMouseY = 0;

    function showHudAlert(text, type = 'danger', duration = 2.0) {
        const el = document.getElementById('hud-alert');
        el.textContent = text;
        el.className = type;
        el.style.opacity = '1';
        GAME.alertTimer = duration;
    }

    function setGravityTarget(gVal) {
        GAME.targetGravityG = MathUtils.clamp(parseFloat(gVal), -1.0, 3.0);
        const slider = document.getElementById('gravity-slider');
        slider.value = GAME.targetGravityG;

        // Cập nhật trạng thái nút preset
        document.querySelectorAll('.grav-btn').forEach(btn => {
            const bg = parseFloat(btn.getAttribute('data-g'));
            btn.classList.toggle('active', Math.abs(bg - GAME.targetGravityG) < 0.02);
        });

        // Hiệu ứng sóng chuyển cảnh trọng lực mượt
        const wave = document.getElementById('gravity-wave-fx');
        wave.style.opacity = '1';
        setTimeout(() => { wave.style.opacity = '0'; }, 420);
        sound.playGravityShift();
    }

    function respawnPlane(inAir = false) {
        airplane.isCrashed = false;
        airplane.isStalling = false;
        airplane.meshRoot.visible = true;
        airplane.fuel = 100.0;
        airplane.angVel.set(0, 0, 0);

        // Đặt máy bay hướng dọc theo đường băng 09 (hướng +X: Yaw = -PI/2 vì mặc định mũi là -Z)
        const euler = new THREE.Euler(0, -Math.PI / 2, 0, 'YXZ');
        airplane.quat.setFromEuler(euler);

        if (inAir) {
            airplane.pos.set(CONFIG.runwayX - 950, CONFIG.baseTerrainY + 210, CONFIG.runwayZ);
            airplane.vel.set(78, 0, 0); // Đang bay ~150 knots hướng về đường băng
            airplane.throttle = 0.68;
            airplane.gearDown = false;
            airplane.gearAnim = 0.0;
            airplane.flapsLevel = 0;
            airplane.onGround = false;
            showHudAlert('ĐANG BAY TRÊN KHÔNG - CHUẨN BỊ TIẾP CẬN', 'info', 2.2);
        } else {
            // Đậu ở đầu đường băng 09 sẵn sàng cất cánh
            airplane.pos.set(CONFIG.runwayX - CONFIG.runwayLength / 2 + 125, CONFIG.baseTerrainY + 1.82, CONFIG.runwayZ);
            airplane.vel.set(0, 0, 0);
            airplane.throttle = 0.0;
            airplane.gearDown = true;
            airplane.gearAnim = 1.0;
            airplane.flapsLevel = 1; // Flaps 15° hỗ trợ cất cánh
            airplane.onGround = true;
            showHudAlert('SẴN SÀNG CẤT CÁNH TẠI ĐƯỜNG BĂNG 09', 'info', 2.2);
        }

        airplane.group.position.copy(airplane.pos);
        airplane.group.quaternion.copy(airplane.quat);
    }

    function setupControls() {
        window.addEventListener('keydown', (e) => {
            const code = e.code;
            keys[code] = true;

            if (code === 'KeyG' && !e.repeat) {
                airplane.gearDown = !airplane.gearDown;
                showHudAlert(airplane.gearDown ? 'BÁNH ĐÁP: ĐANG HẠ (GEAR DOWN)' : 'BÁNH ĐÁP: ĐANG THU (GEAR UP)', 'info', 1.4);
            } else if (code === 'KeyF' && !e.repeat) {
                airplane.flapsLevel = (airplane.flapsLevel + 1) % 3;
                const degs = [0, 15, 30][airplane.flapsLevel];
                showHudAlert(`CÁNH TÀ (FLAPS): ${degs}°`, 'info', 1.3);
            } else if (code === 'KeyC' && !e.repeat) {
                cycleCameraMode();
            } else if (code === 'KeyN' && !e.repeat) {
                cycleTimeOfDay();
            } else if (code === 'KeyM' && !e.repeat) {
                toggleMouseSteer();
            } else if (code === 'BracketLeft') {
                setGravityTarget(GAME.targetGravityG - 0.15);
            } else if (code === 'BracketRight') {
                setGravityTarget(GAME.targetGravityG + 0.15);
            } else if (code === 'KeyR' && !e.repeat) {
                respawnPlane(false);
            } else if (code === 'KeyB' && !e.repeat) {
                respawnPlane(true);
            } else if ((code === 'KeyP' || code === 'Escape') && !e.repeat) {
                togglePauseMenu();
            }
        });

        window.addEventListener('keyup', (e) => {
            keys[e.code] = false;
        });

        // Điều khiển chuột (Lái máy bay hoặc Xoay camera ngoài)
        window.addEventListener('mousemove', (e) => {
            GAME.mouseX = (e.clientX / window.innerWidth) * 2 - 1;
            GAME.mouseY = (e.clientY / window.innerHeight) * 2 - 1;

            if (isDraggingOrbit && GAME.cameraMode === 2) {
                GAME.orbitAngleX -= (e.clientX - prevMouseX) * 0.007;
                GAME.orbitAngleY = MathUtils.clamp(GAME.orbitAngleY + (e.clientY - prevMouseY) * 0.006, -0.35, 1.35);
                prevMouseX = e.clientX;
                prevMouseY = e.clientY;
            }
        });

        window.addEventListener('mousedown', (e) => {
            if (e.target.closest('.hud-interactive') || e.target.closest('#modal-overlay')) return;
            if (GAME.cameraMode === 2) {
                isDraggingOrbit = true;
                prevMouseX = e.clientX;
                prevMouseY = e.clientY;
            }
        });
        window.addEventListener('mouseup', () => { isDraggingOrbit = false; });

        // Điều khiển cảm ứng (Virtual Joystick) cho điện thoại
        const joyZone = document.getElementById('joystick-zone');
        const joyKnob = document.getElementById('joystick-knob');
        let joyCenter = { x: 0, y: 0 };

        joyZone.addEventListener('touchstart', (e) => {
            e.preventDefault();
            const rect = joyZone.getBoundingClientRect();
            joyCenter = { x: rect.left + rect.width / 2, y: rect.top + rect.height / 2 };
            touchInput.active = true;
            handleJoystickMove(e.touches[0]);
        }, { passive: false });

        joyZone.addEventListener('touchmove', (e) => {
            e.preventDefault();
            if (touchInput.active) handleJoystickMove(e.touches[0]);
        }, { passive: false });

        const resetJoy = () => {
            touchInput.active = false;
            touchInput.pitch = 0;
            touchInput.roll = 0;
            joyKnob.style.transform = `translate(0px, 0px)`;
        };
        joyZone.addEventListener('touchend', resetJoy);
        joyZone.addEventListener('touchcancel', resetJoy);

        function handleJoystickMove(touch) {
            const maxR = 46;
            let dx = touch.clientX - joyCenter.x;
            let dy = touch.clientY - joyCenter.y;
            const dist = Math.hypot(dx, dy);
            if (dist > maxR) {
                dx = (dx / dist) * maxR;
                dy = (dy / dist) * maxR;
            }
            joyKnob.style.transform = `translate(${dx}px, ${dy}px)`;
            touchInput.roll = dx / maxR;
            touchInput.pitch = dy / maxR;
        }

        // Các nút cảm ứng bên phải
        const bindTouchHold = (id, prop) => {
            const btn = document.getElementById(id);
            btn.addEventListener('touchstart', (e) => { e.preventDefault(); touchInput[prop] = true; });
            btn.addEventListener('touchend', () => { touchInput[prop] = false; });
        };
        bindTouchHold('touch-thr-up', 'thrUp');
        bindTouchHold('touch-thr-down', 'thrDown');
        document.getElementById('touch-gear').addEventListener('click', () => { airplane.gearDown = !airplane.gearDown; });
        document.getElementById('touch-flaps').addEventListener('click', () => { airplane.flapsLevel = (airplane.flapsLevel + 1) % 3; });
        const brakeBtn = document.getElementById('touch-brake');
        brakeBtn.addEventListener('touchstart', (e) => { e.preventDefault(); keys['Space'] = true; });
        brakeBtn.addEventListener('touchend', () => { keys['Space'] = false; });
    }

    // ============================================================================
    // 12. VẬT LÝ KHÍ ĐỘNG HỌC BÁN THỰC TẾ & XỬ LÝ VA CHẠM
    // ============================================================================
    function updateFlightPhysics(dt) {
        // Nội suy trọng lực mượt
        GAME.gravityG = MathUtils.lerp(GAME.gravityG, GAME.targetGravityG, Math.min(1, dt * 5.5));
        const gNames = {
            '-1': 'Đảo Ngược',
            '0': 'Không Trọng Lực',
            '0.16': 'Mặt Trăng',
            '0.38': 'Sao Hỏa',
            '1': 'Trái Đất',
            '3': 'Siêu Nặng'
        };
        let presetLabel = 'Tùy chỉnh';
        for (let k in gNames) {
            if (Math.abs(parseFloat(k) - GAME.gravityG) < 0.05) presetLabel = gNames[k];
        }
        document.getElementById('gravity-readout').textContent = `${GAME.gravityG.toFixed(2)} g (${presetLabel})`;

        // Nếu máy bay đã nổ, đếm ngược hồi sinh
        if (airplane.isCrashed) {
            airplane.crashTimer -= dt;
            if (airplane.crashTimer <= 0) {
                respawnPlane(false);
            }
            return;
        }

        // 1. Đọc tín hiệu điều khiển Pitch / Roll / Yaw / Ga / Phanh
        let pitchCmd = 0; // +1: Ngóc mũi (Pitch Up), -1: Chúc mũi (Pitch Down)
        let rollCmd = 0;  // +1: Nghiêng trái, -1: Nghiêng phải
        let yawCmd = 0;   // +1: Lái trái, -1: Lái phải

        if (keys['KeyS'] || keys['ArrowDown']) pitchCmd += 1;
        if (keys['KeyW'] || keys['ArrowUp']) pitchCmd -= 1;
        if (keys['KeyA'] || keys['ArrowLeft']) rollCmd += 1;
        if (keys['KeyD'] || keys['ArrowRight']) rollCmd -= 1;
        if (keys['KeyQ']) yawCmd += 1;
        if (keys['KeyE']) yawCmd -= 1;

        if (GAME.mouseSteer) {
            rollCmd = MathUtils.clamp(-GAME.mouseX * 1.4, -1, 1);
            pitchCmd = MathUtils.clamp(GAME.mouseY * 1.4, -1, 1);
        }
        if (touchInput.active) {
            rollCmd = -touchInput.roll;
            pitchCmd = touchInput.pitch;
        }

        // Điều chỉnh tay ga (Shift / Ctrl) & tiêu hao nhiên liệu
        if (keys['ShiftLeft'] || keys['ShiftRight'] || touchInput.thrUp) {
            airplane.throttle = MathUtils.clamp(airplane.throttle + dt * 0.48, 0, 1);
        }
        if (keys['ControlLeft'] || keys['ControlRight'] || touchInput.thrDown) {
            airplane.throttle = MathUtils.clamp(airplane.throttle - dt * 0.48, 0, 1);
        }
        if (airplane.fuel <= 0) {
            airplane.fuel = 0;
            airplane.throttle = 0;
        } else {
            // Tiêu thụ nhiên liệu tỉ lệ với mức ga (tiếp nhiên liệu tự động khi đỗ trên đường băng)
            const fuelRate = airplane.throttle > 0.85 ? 0.65 : 0.22 * airplane.throttle;
            airplane.fuel = MathUtils.clamp(airplane.fuel - fuelRate * dt, 0, 100);
        }

        airplane.braking = !!keys['Space'];

        // Hoạt ảnh thu/thả bánh đáp mượt
        const targetGear = airplane.gearDown ? 1.0 : 0.0;
        airplane.gearAnim = MathUtils.lerp(airplane.gearAnim, targetGear, dt * 3.2);
        airplane.gearGroup.scale.y = Math.max(0.01, airplane.gearAnim);
        airplane.gearGroup.visible = airplane.gearAnim > 0.05;

        // Hoạt ảnh các mặt điều khiển bay (Ailerons, Elevators, Rudders, Flaps)
        const flapAngle = [0, 0.28, 0.54][airplane.flapsLevel];
        airplane.leftAileron.rotation.x = rollCmd * 0.38;
        airplane.rightAileron.rotation.x = -rollCmd * 0.38;
        airplane.leftElevator.rotation.x = -pitchCmd * 0.36;
        airplane.rightElevator.rotation.x = -pitchCmd * 0.36;
        airplane.leftRudder.rotation.y = yawCmd * 0.42;
        airplane.rightRudder.rotation.y = yawCmd * 0.42;
        airplane.leftFlap.rotation.x = flapAngle;
        airplane.rightFlap.rotation.x = flapAngle;

        // Hiệu ứng lửa động cơ đốt sau (Afterburner)
        const abScale = airplane.throttle > 0.1 ? (0.3 + airplane.throttle * 1.15 + Math.sin(performance.now() * 0.06) * 0.12) : 0.001;
        airplane.afterburnerL.scale.set(1, 1, abScale);
        airplane.afterburnerR.scale.set(1, 1, abScale);
        airplane.afterburnerL.visible = airplane.throttle > 0.08;
        airplane.afterburnerR.visible = airplane.throttle > 0.08;
        const abColor = airplane.throttle > 0.85 ? 0xf97316 : 0x38bdf8;
        airplane.afterburnerL.material.color.setHex(abColor);
        airplane.afterburnerR.material.color.setHex(abColor);

        // 2. Các vector trục cục bộ của máy bay trong không gian thế giới
        const forward = new THREE.Vector3(0, 0, -1).applyQuaternion(airplane.quat).normalize();
        const up = new THREE.Vector3(0, 1, 0).applyQuaternion(airplane.quat).normalize();
        const right = new THREE.Vector3(1, 0, 0).applyQuaternion(airplane.quat).normalize();

        const speed = airplane.vel.length();
        airplane.speedMs = speed;

        // Vận tốc trong hệ quy chiếu cục bộ của máy bay
        const invQuat = airplane.quat.clone().invert();
        const localVel = airplane.vel.clone().applyQuaternion(invQuat);
        const forwardSpeed = Math.max(0, -localVel.z);

        // Tính Góc tấn (Angle of Attack - AoA)
        let aoaRad = 0;
        if (speed > 4.0) {
            aoaRad = Math.atan2(-localVel.y, Math.max(1.0, -localVel.z));
        }
        const aoaDeg = THREE.MathUtils.radToDeg(aoaRad);
        airplane.aoaDeg = aoaDeg;

        // 3. Mô hình Khí động học: Lực nâng (Lift), Lực cản (Drag), Lực đẩy (Thrust), Trọng lực (Weight)
        const flapLiftBonus = [0, 0.26, 0.48][airplane.flapsLevel];
        const flapDragBonus = [0, 0.022, 0.058][airplane.flapsLevel];
        const gearDragBonus = airplane.gearAnim * 0.032;
        const brakeDragBonus = airplane.braking ? 0.095 : 0.0;

        // Kiểm tra hiện tượng Thất tốc (Stall) khi góc tấn quá lớn (> 16.5°) hoặc bay quá chậm trên không
        const criticalAoA = 16.5 + airplane.flapsLevel * 1.5;
        let cl = 0;
        airplane.isStalling = false;

        if (Math.abs(aoaDeg) < criticalAoA) {
            // Vùng tuyến tính: Hệ số lực nâng tăng theo góc tấn + độ camber cánh + Flaps
            cl = (aoaDeg + 2.4) * 0.095 + flapLiftBonus;
        } else {
            // Vùng thất tốc (Stall): Lực nâng sụt giảm mạnh!
            const excess = Math.abs(aoaDeg) - criticalAoA;
            const sign = Math.sign(aoaDeg + 2.4);
            cl = sign * Math.max(0.12, (criticalAoA + 2.4) * 0.095 + flapLiftBonus - excess * 0.085);
            if (!airplane.onGround && speed > 18) {
                airplane.isStalling = true;
            }
        }
        if (!airplane.onGround && speed < 36 && GAME.gravityG > 0.25 && airplane.pos.y > CONFIG.baseTerrainY + 12) {
            airplane.isStalling = true;
        }

        // Áp suất động lực học q = 0.5 * rho * v^2 * S / mass
        const aeroFactor = 0.0044;
        const liftAccelMag = aeroFactor * forwardSpeed * forwardSpeed * cl;
        const liftAccel = up.clone().multiplyScalar(liftAccelMag);

        // Lực cản (Parasitic + Induced + Flaps + Gear + Airbrake)
        const cd = 0.021 + cl * cl * 0.055 + flapDragBonus + gearDragBonus + brakeDragBonus;
        const dragAccelMag = aeroFactor * speed * speed * cd;
        const dragAccel = speed > 0.01
            ? airplane.vel.clone().normalize().multiplyScalar(-dragAccelMag)
            : new THREE.Vector3();

        // Lực cản trượt ngang thân (Sideslip Damping giúp máy bay bay thẳng theo hướng mũi)
        const sideVel = localVel.x;
        const sideForce = right.clone().multiplyScalar(-sideVel * Math.min(4.5, 0.4 + forwardSpeed * 0.04));

        // Lực đẩy động cơ phản lực (Thrust + Afterburner)
        const maxThrustAccel = airplane.throttle > 0.85 ? 25.5 : 18.5;
        const thrustAccel = forward.clone().multiplyScalar(airplane.throttle * maxThrustAccel);

        // Trọng lực biến thiên theo thanh trượt HUD (-1g đến 3g)
        const gravityAccel = new THREE.Vector3(0, -GAME.gravityG * CONFIG.gravityEarth, 0);

        // Tổng hợp gia tốc
        const totalAccel = new THREE.Vector3()
            .add(thrustAccel)
            .add(liftAccel)
            .add(dragAccel)
            .add(sideForce)
            .add(gravityAccel);

        airplane.vel.addScaledVector(totalAccel, dt);

        // Tính chỉ số G-Force cảm nhận bởi phi công
        const nonGravAccel = totalAccel.clone().sub(gravityAccel);
        airplane.gForce = nonGravAccel.dot(up) / CONFIG.gravityEarth;

        // 4. Vận tốc góc (Pitch, Roll, Yaw) và Độ ổn định khí động học
        const ctrlAuthority = MathUtils.clamp(0.28 + forwardSpeed / 65, 0.28, 1.35);
        let targetPitchRate = pitchCmd * 1.45 * ctrlAuthority;
        let targetRollRate = rollCmd * 2.55 * ctrlAuthority;
        let targetYawRate = yawCmd * 0.85 * ctrlAuthority;

        // Khi thất tốc (Stall), mũi máy bay tự động chúc xuống và cánh rung lắc
        if (airplane.isStalling) {
            targetPitchRate -= 0.95;
            targetRollRate += Math.sin(performance.now() * 0.025) * 0.85;
            showHudAlert('⚠️ STALL - THẤT TỐC! HẠ MŨI & TĂNG GA!', 'danger', 0.25);
        }

        // Lái bánh mũi khi đang chạy trên mặt đất
        if (airplane.onGround) {
            targetYawRate = (yawCmd - rollCmd * 0.45) * MathUtils.clamp(forwardSpeed / 22, 0.15, 1.1);
            targetRollRate *= 0.25;
        }

        airplane.angVel.x = MathUtils.lerp(airplane.angVel.x, targetPitchRate, dt * 6.5);
        airplane.angVel.y = MathUtils.lerp(airplane.angVel.y, targetYawRate, dt * 5.5);
        airplane.angVel.z = MathUtils.lerp(airplane.angVel.z, targetRollRate, dt * 7.5);

        const dq = new THREE.Quaternion();
        const rotEuler = new THREE.Euler(
            airplane.angVel.x * dt,
            airplane.angVel.y * dt,
            airplane.angVel.z * dt,
            'YXZ'
        );
        dq.setFromEuler(rotEuler);
        airplane.quat.multiply(dq).normalize();

        // Cập nhật vị trí máy bay
        airplane.pos.addScaledVector(airplane.vel, dt);
        airplane.verticalSpeed = airplane.vel.y;

        // 5. Tính toán góc Pitch, Roll, Heading cho HUD
        const forwardFlat = new THREE.Vector3(forward.x, 0, forward.z);
        if (forwardFlat.lengthSq() > 0.0001) forwardFlat.normalize();
        // Bắc = -Z (0°), Đông = +X (90°), Nam = +Z (180°), Tây = -X (270°)
        let hdg = THREE.MathUtils.radToDeg(Math.atan2(forward.x, -forward.z));
        if (hdg < 0) hdg += 360;
        airplane.headingDeg = hdg;
        airplane.pitchDeg = THREE.MathUtils.radToDeg(Math.asin(MathUtils.clamp(forward.y, -1, 1)));

        const worldUp = new THREE.Vector3(0, 1, 0);
        const rightFlat = new THREE.Vector3().crossVectors(forward, worldUp).normalize();
        const upProj = new THREE.Vector3().crossVectors(rightFlat, forward).normalize();
        airplane.rollDeg = THREE.MathUtils.radToDeg(Math.atan2(right.dot(worldUp), up.dot(upProj)));

        // 6. Kiểm tra tiếp đất (Touchdown), lăn bánh trên đường băng & va chạm địa hình
        const groundHeight = getTerrainHeight(airplane.pos.x, airplane.pos.z);
        const gearOffset = airplane.gearDown ? 1.78 : 0.92;
        const minPlaneY = groundHeight + gearOffset;

        const onRunwayArea =
            Math.abs(airplane.pos.x - CONFIG.runwayX) <= CONFIG.runwayLength * 0.52 &&
            Math.abs(airplane.pos.z - CONFIG.runwayZ) <= CONFIG.runwayWidth * 0.65;

        if (airplane.pos.y <= minPlaneY) {
            // Chạm mặt nước -> Nổ
            if (groundHeight < CONFIG.waterLevel + 0.3) {
                crashPlane('💥 RƠI XUỐNG MẶT NƯỚC! ĐANG HỒI SINH...');
                return;
            }

            // Kiểm tra điều kiện hạ cánh an toàn khi từ trên không chạm đất
            if (!airplane.onGround) {
                const impactVS = Math.abs(airplane.vel.y);
                const excessiveRoll = Math.abs(airplane.rollDeg) > 26;
                const excessivePitch = airplane.pitchDeg < -18 || airplane.pitchDeg > 28;
                const noGearCrash = !airplane.gearDown && speed > 28;

                if (impactVS > 11.5 || excessiveRoll || excessivePitch || noGearCrash) {
                    const reason = !airplane.gearDown
                        ? '💥 QUÊN HẠ BÁNH ĐÁP (PHÍM G) KHI HẠ CÁNH!'
                        : `💥 HẠ CÁNH QUÁ MẠNH (${impactVS.toFixed(1)} m/s)!`;
                    crashPlane(reason);
                    return;
                }

                // Hạ cánh thành công! Sinh khói lốp & âm thanh chạm đường băng
                sound.playTouchdown();
                for (let i = 0; i < 16; i++) {
                    spawnParticle(
                        new THREE.Vector3(airplane.pos.x, groundHeight + 0.4, airplane.pos.z),
                        new THREE.Vector3((Math.random() - 0.5) * 8, Math.random() * 3, (Math.random() - 0.5) * 8),
                        0.9,
                        0.9,
                        0xe2e8f0,
                        false
                    );
                }
                if (onRunwayArea && speed > 20) {
                    showHudAlert('🛬 CHẠM ĐƯỜNG BĂNG AN TOÀN! GIỮ SPACE ĐỂ PHANH', 'info', 2.5);
                }
                airplane.onGround = true;
            }

            airplane.pos.y = minPlaneY;
            if (airplane.vel.y < 0) airplane.vel.y = 0;

            // Ma sát lăn bánh và phanh trên đường băng
            const friction = airplane.braking ? 0.92 : (onRunwayArea ? 0.08 : 0.45);
            const speedDrop = Math.max(0, speed - friction * 14 * dt);
            if (speed > 0.01) {
                // Giữ vận tốc hướng dọc theo mũi máy bay khi chạy trên đường băng
                const groundForward = new THREE.Vector3(forward.x, 0, forward.z).normalize();
                airplane.vel.copy(groundForward).multiplyScalar(speedDrop);
            }

            // Cân bằng lại góc nghiêng cánh và chúc mũi khi trên mặt đất
            const currentEuler = new THREE.Euler().setFromQuaternion(airplane.quat, 'YXZ');
            currentEuler.z = MathUtils.lerp(currentEuler.z, 0, dt * 8);
            if (currentEuler.x < 0) currentEuler.x = MathUtils.lerp(currentEuler.x, 0, dt * 8);
            currentEuler.x = MathUtils.clamp(currentEuler.x, -0.05, 0.26);
            airplane.quat.setFromEuler(currentEuler);

            // Tiếp nhiên liệu tự động khi dừng trên đường băng
            if (onRunwayArea && speed < 5) {
                airplane.fuel = MathUtils.clamp(airplane.fuel + dt * 15, 0, 100);
            }
        } else {
            airplane.onGround = false;
        }

        // 7. Kiểm tra va chạm với Tòa nhà cao tầng, Tháp kiểm soát, Cầu...
        for (let i = 0; i < colliders.length; i++) {
            const c = colliders[i];
            if (
                Math.abs(airplane.pos.x - c.x) < c.rx + 4.5 &&
                Math.abs(airplane.pos.z - c.z) < c.rz + 4.5 &&
                airplane.pos.y < c.maxY + 1.5
            ) {
                crashPlane('💥 VA CHẠM CÔNG TRÌNH! ĐANG HỒI SINH...');
                return;
            }
        }

        // 8. Hiệu ứng vệt khói đầu cánh (Wingtip Vortices) & Bụi mặt đất khi bay thấp
        if (speed > 48 && (Math.abs(aoaDeg) > 5.5 || Math.abs(airplane.gForce) > 1.45 || speed > 85)) {
            const worldTipL = airplane.wingtipL.clone().applyQuaternion(airplane.quat).add(airplane.pos);
            const worldTipR = airplane.wingtipR.clone().applyQuaternion(airplane.quat).add(airplane.pos);
            const smokeVel = airplane.vel.clone().multiplyScalar(0.12);
            spawnParticle(worldTipL, smokeVel, 0.42, 0.55, 0xf8fafc, false);
            spawnParticle(worldTipR, smokeVel, 0.42, 0.55, 0xf8fafc, false);
        }

        const agl = airplane.pos.y - groundHeight;
        if (agl < 14 && speed > 32 && groundHeight > CONFIG.waterLevel + 0.5) {
            spawnParticle(
                new THREE.Vector3(airplane.pos.x + (Math.random() - 0.5) * 6, groundHeight + 0.5, airplane.pos.z + (Math.random() - 0.5) * 6),
                new THREE.Vector3((Math.random() - 0.5) * 10, 2 + Math.random() * 4, (Math.random() - 0.5) * 10),
                1.1,
                0.7,
                onRunwayArea ? 0xcbd5e1 : 0xa8a29e,
                true
            );
        }

        airplane.group.position.copy(airplane.pos);
        airplane.group.quaternion.copy(airplane.quat);
    }

    function crashPlane(message) {
        airplane.isCrashed = true;
        airplane.crashTimer = 3.0;
        airplane.meshRoot.visible = false;
        airplane.vel.set(0, 0, 0);
        triggerCrashExplosion(airplane.pos);
        showHudAlert(message, 'danger', 3.0);
    }

    // ============================================================================
    // 13. HỆ THỐNG CAMERA (SAU LƯNG, BUỒNG LÁI, NGOÀI) & RUNG CAMERA TỐC ĐỘ CAO
    // ============================================================================
    const camSmoothPos = new THREE.Vector3();
    const camSmoothLook = new THREE.Vector3();
    let camInitialized = false;

    function updateCamera(dt) {
        const forward = new THREE.Vector3(0, 0, -1).applyQuaternion(airplane.quat).normalize();
        const up = new THREE.Vector3(0, 1, 0).applyQuaternion(airplane.quat).normalize();

        // Độ rung camera khi bay tốc độ cao, đốt sau (Afterburner) hoặc thất tốc (Stall)
        let shakeIntensity = 0;
        if (!airplane.isCrashed) {
            if (airplane.speedMs > 85) shakeIntensity += ((airplane.speedMs - 85) / 140) * 0.14;
            if (airplane.throttle > 0.85) shakeIntensity += 0.08;
            if (airplane.isStalling) shakeIntensity += 0.18;
        }
        const shakeVec = new THREE.Vector3(
            (Math.random() - 0.5) * shakeIntensity,
            (Math.random() - 0.5) * shakeIntensity,
            (Math.random() - 0.5) * shakeIntensity
        );

        if (GAME.cameraMode === 0) {
            // 0: Camera Sau lưng (Chase Camera)
            airplane.meshRoot.visible = !airplane.isCrashed;
            const desiredPos = airplane.pos.clone()
                .addScaledVector(forward, -21.5)
                .addScaledVector(up, 5.4);

            const minCamY = getTerrainHeight(desiredPos.x, desiredPos.z) + 1.5;
            if (desiredPos.y < minCamY) desiredPos.y = minCamY;

            const desiredLook = airplane.pos.clone().addScaledVector(forward, 18.0).addScaledVector(up, 1.2);

            if (!camInitialized) {
                camSmoothPos.copy(desiredPos);
                camSmoothLook.copy(desiredLook);
                camInitialized = true;
            } else {
                camSmoothPos.lerp(desiredPos, Math.min(1, dt * 10.5));
                camSmoothLook.lerp(desiredLook, Math.min(1, dt * 14.0));
            }

            camera.position.copy(camSmoothPos).add(shakeVec);
            camera.up.set(0, 1, 0);
            camera.lookAt(camSmoothLook);
            camera.fov = MathUtils.lerp(camera.fov, 60 + MathUtils.clamp((airplane.speedMs - 50) * 0.15, 0, 18), dt * 5);
            camera.updateProjectionMatrix();

        } else if (GAME.cameraMode === 1) {
            // 1: Camera Buồng lái (Cockpit First-Person View)
            const cockpitPos = airplane.pos.clone()
                .addScaledVector(forward, 2.25)
                .addScaledVector(up, 0.92)
                .add(shakeVec.multiplyScalar(0.5));
            camera.position.copy(cockpitPos);
            camera.up.copy(up);
            camera.lookAt(cockpitPos.clone().addScaledVector(forward, 50));
            camera.fov = 66;
            camera.updateProjectionMatrix();

        } else {
            // 2: Camera Ngoài / Điện ảnh xoay quanh máy bay (Orbit View)
            const dist = 26;
            const ox = Math.cos(GAME.orbitAngleY) * Math.sin(GAME.orbitAngleX) * dist;
            const oy = Math.sin(GAME.orbitAngleY) * dist;
            const oz = Math.cos(GAME.orbitAngleY) * Math.cos(GAME.orbitAngleX) * dist;
            const desiredPos = airplane.pos.clone().add(new THREE.Vector3(ox, oy, oz));
            const minCamY = getTerrainHeight(desiredPos.x, desiredPos.z) + 1.5;
            if (desiredPos.y < minCamY) desiredPos.y = minCamY;

            camera.position.copy(desiredPos).add(shakeVec);
            camera.up.set(0, 1, 0);
            camera.lookAt(airplane.pos);
            camera.fov = 55;
            camera.updateProjectionMatrix();
        }

        // Cập nhật vùng đổ bóng mặt trời đi theo máy bay để bóng luôn sắc nét
        sunLight.position.copy(airplane.pos).addScaledVector(sunDir, 900);
        sunLight.target.position.copy(airplane.pos);
        skyDome.position.copy(camera.position);
    }

    // ============================================================================
    // 14. CHU KỲ NGÀY/ĐÊM, ĐÈN PAPI, CỘT GIÓ & HIỆU ỨNG LENS FLARE MẶT TRỜI
    // ============================================================================
    const lensCanvas = document.getElementById('lens-flare-canvas');
    const lensCtx = lensCanvas.getContext('2d');

    function updateEnvironmentAndLights(dt, elapsed) {
        waterUniforms.uTime.value = elapsed;

        // Xoay đèn hải đăng trên đỉnh tháp kiểm soát không lưu
        if (beaconHead) beaconHead.rotation.y = elapsed * 2.4;

        // Cột gió bay phấp phới & phản ứng theo trọng lực
        if (windsockCone) {
            windsockCone.rotation.z = Math.sin(elapsed * 4.5) * 0.12 - (GAME.gravityG - 1.0) * 0.22;
            windsockCone.rotation.y = Math.cos(elapsed * 3.1) * 0.15;
        }

        // Nội suy chu kỳ Ngày (0.0) -> Hoàng hôn (0.5) -> Đêm (1.0)
        GAME.timeTransition = MathUtils.lerp(GAME.timeTransition, GAME.targetTimeTransition, Math.min(1, dt * 2.5));
        const t = GAME.timeTransition;

        // Góc cao của mặt trời
        const sunElev = MathUtils.lerp(0.52, -0.18, t);
        sunDir.set(0.62, sunElev, -0.65).normalize();
        skyUniforms.uSunDir.value.copy(sunDir);
        waterUniforms.uSunDir.value.copy(sunDir);

        const cTopDay = new THREE.Color(0x0b3c7c);
        const cTopSunset = new THREE.Color(0x1e1b4b);
        const cTopNight = new THREE.Color(0x020617);

        const cHorDay = new THREE.Color(0x93c5fd);
        const cHorSunset = new THREE.Color(0xf97316);
        const cHorNight = new THREE.Color(0x09152b);

        const cSunDay = new THREE.Color(0xfffbeb);
        const cSunSunset = new THREE.Color(0xfb7185);
        const cSunNight = new THREE.Color(0x38bdf8);

        if (t < 0.5) {
            const k = t * 2.0;
            skyUniforms.uTopColor.value.copy(cTopDay).lerp(cTopSunset, k);
            skyUniforms.uHorizonColor.value.copy(cHorDay).lerp(cHorSunset, k);
            skyUniforms.uSunColor.value.copy(cSunDay).lerp(cSunSunset, k);
        } else {
            const k = (t - 0.5) * 2.0;
            skyUniforms.uTopColor.value.copy(cTopSunset).lerp(cTopNight, k);
            skyUniforms.uHorizonColor.value.copy(cHorSunset).lerp(cHorNight, k);
            skyUniforms.uSunColor.value.copy(cSunSunset).lerp(cSunNight, k);
        }

        const nightFactor = MathUtils.smoothstep(0.35, 0.9, t);
        skyUniforms.uNightFactor.value = nightFactor;
        scene.fog.color.copy(skyUniforms.uHorizonColor.value);
        waterUniforms.uSkyHorizon.value.copy(skyUniforms.uHorizonColor.value);
        waterUniforms.uSunColor.value.copy(skyUniforms.uSunColor.value);

        sunLight.intensity = MathUtils.lerp(1.38, 0.14, nightFactor);
        sunLight.color.copy(skyUniforms.uSunColor.value);
        hemiLight.intensity = MathUtils.lerp(0.68, 0.22, nightFactor);

        // Bật sáng cửa sổ thành phố, nhà ga, đèn pha máy bay và đèn xoay sân bay vào ban đêm
        for (let item of dynamicLightMaterials) {
            item.mat.emissiveIntensity = MathUtils.lerp(item.dayIntensity, item.nightIntensity, nightFactor);
        }
        if (beaconBeam) beaconBeam.material.opacity = MathUtils.lerp(0.06, 0.42, nightFactor);
        if (airplane.landingLight) {
            airplane.landingLight.intensity = (airplane.gearDown ? 1 : 0) * MathUtils.lerp(0.15, 2.2, nightFactor);
        }
        if (airplane.strobeLight) {
            const flash = Math.sin(elapsed * 14.0) > 0.75 ? 1.8 : 0.0;
            airplane.strobeLight.intensity = flash;
        }

        // Cập nhật hệ thống 4 đèn dẫn đường hạ cánh PAPI theo góc tiếp cận thực tế của người chơi
        const rwyTouchdownX = CONFIG.runwayX - CONFIG.runwayLength / 2 + 230;
        const distToTouchdown = Math.hypot(airplane.pos.x - rwyTouchdownX, airplane.pos.z - CONFIG.runwayZ);
        const relAlt = Math.max(0, airplane.pos.y - CONFIG.baseTerrainY);
        const glideSlopeDeg = THREE.MathUtils.radToDeg(Math.atan2(relAlt, Math.max(10, distToTouchdown)));

        let whiteCount = 0;
        for (let i = 0; i < papiLights.length; i++) {
            const isWhite = glideSlopeDeg >= papiLights[i].thresholdDeg;
            if (isWhite) whiteCount++;
            papiLights[i].mat.color.setHex(isWhite ? 0xffffff : 0xff2222);
        }
        const papiIcons = '⚪'.repeat(whiteCount) + '🔴'.repeat(4 - whiteCount);
        const papiStatus = whiteCount === 2 ? 'CHUẨN 3°' : (whiteCount > 2 ? 'CAO' : 'THẤP');
        document.getElementById('hud-papi').textContent = `${papiIcons} ${papiStatus}`;

        // Vẽ hiệu ứng Lens Flare Mặt Trời
        renderSunLensFlare(nightFactor);
    }

    function renderSunLensFlare(nightFactor) {
        if (lensCanvas.width !== window.innerWidth || lensCanvas.height !== window.innerHeight) {
            lensCanvas.width = window.innerWidth;
            lensCanvas.height = window.innerHeight;
        }
        lensCtx.clearRect(0, 0, lensCanvas.width, lensCanvas.height);
        if (nightFactor > 0.72 || sunDir.y < 0.0) return;

        const sunWorldPos = camera.position.clone().addScaledVector(sunDir, 5000);
        const camForward = new THREE.Vector3();
        camera.getWorldDirection(camForward);
        const dotSun = camForward.dot(sunDir);
        if (dotSun <= 0.15) return;

        const projected = sunWorldPos.project(camera);
        const sx = (projected.x * 0.5 + 0.5) * lensCanvas.width;
        const sy = (-projected.y * 0.5 + 0.5) * lensCanvas.height;
        const cx = lensCanvas.width * 0.5;
        const cy = lensCanvas.height * 0.5;

        const alpha = MathUtils.clamp((dotSun - 0.15) * 1.4, 0, 0.75) * (1.0 - nightFactor);
        const dx = cx - sx;
        const dy = cy - sy;

        lensCtx.save();
        lensCtx.globalCompositeOperation = 'lighter';

        const flares = [
            { t: 0.0, r: 95, col: `rgba(255, 245, 210, ${alpha * 0.45})` },
            { t: 0.35, r: 28, col: `rgba(56, 189, 248, ${alpha * 0.25})` },
            { t: 0.75, r: 46, col: `rgba(251, 191, 36, ${alpha * 0.22})` },
            { t: 1.15, r: 20, col: `rgba(168, 85, 247, ${alpha * 0.25})` },
            { t: 1.55, r: 64, col: `rgba(52, 211, 153, ${alpha * 0.18})` }
        ];

        for (let f of flares) {
            const fx = sx + dx * f.t;
            const fy = sy + dy * f.t;
            const g = lensCtx.createRadialGradient(fx, fy, 1, fx, fy, f.r);
            g.addColorStop(0, f.col);
            g.addColorStop(1, 'rgba(0,0,0,0)');
            lensCtx.fillStyle = g;
            lensCtx.beginPath();
            lensCtx.arc(fx, fy, f.r, 0, Math.PI * 2);
            lensCtx.fill();
        }
        lensCtx.restore();
    }

    // ============================================================================
    // 15. CẬP NHẬT GIAO DIỆN HUD: ĐƯỜNG CHÂN TRỜI NHÂN TẠO, LA BÀN & MINI-MAP
    // ============================================================================
    const horizonCanvas = document.getElementById('horizon-canvas');
    const hCtx = horizonCanvas.getContext('2d');
    const compassCanvas = document.getElementById('compass-canvas');
    const cCtx = compassCanvas.getContext('2d');
    const minimapCanvas = document.getElementById('minimap-canvas');
    const mCtx = minimapCanvas.getContext('2d');

    function updateHUD(dt) {
        if (GAME.alertTimer > 0) {
            GAME.alertTimer -= dt;
            if (GAME.alertTimer <= 0) {
                document.getElementById('hud-alert').style.opacity = '0';
            }
        }

        const knots = Math.round(airplane.speedMs * 1.94384);
        const kmh = Math.round(airplane.speedMs * 3.6);
        const altM = Math.max(0, Math.round(airplane.pos.y - CONFIG.waterLevel));
        const altFt = Math.round(altM * 3.28084);

        document.getElementById('hud-speed').textContent = `${knots} KT (${kmh} km/h)`;
        document.getElementById('hud-alt').textContent = `${altM} m (${altFt} ft)`;
        document.getElementById('hud-vs').textContent = `${airplane.verticalSpeed >= 0 ? '+' : ''}${airplane.verticalSpeed.toFixed(1)} m/s`;
        document.getElementById('hud-aoa').textContent = `${airplane.aoaDeg.toFixed(1)}°`;
        document.getElementById('hud-gforce').textContent = `${airplane.gForce.toFixed(1)} G`;

        // Cập nhật thanh Ga & Nhiên liệu
        const thrPct = Math.round(airplane.throttle * 100);
        document.getElementById('hud-thr-val').textContent = `${thrPct}%`;
        document.getElementById('throttle-fill').style.height = `${thrPct}%`;

        const fuelPct = Math.round(airplane.fuel);
        document.getElementById('hud-fuel-val').textContent = `${fuelPct}%`;
        document.getElementById('fuel-fill').style.height = `${fuelPct}%`;

        // Cập nhật trạng thái cơ giới
        const gearEl = document.getElementById('sys-gear');
        gearEl.textContent = airplane.gearDown ? 'HẠ (DOWN)' : 'THU (UP)';
        gearEl.className = airplane.gearDown ? 'on' : 'warn';

        const flapsEl = document.getElementById('sys-flaps');
        const flapDegs = [0, 15, 30][airplane.flapsLevel];
        flapsEl.textContent = `${flapDegs}°`;
        flapsEl.className = airplane.flapsLevel > 0 ? 'on' : 'off';

        const brakeEl = document.getElementById('sys-brake');
        brakeEl.textContent = airplane.braking ? 'ĐANG PHANH' : 'NHẢ';
        brakeEl.className = airplane.braking ? 'warn' : 'off';

        const abEl = document.getElementById('sys-ab');
        abEl.textContent = airplane.throttle > 0.85 ? 'ĐỐT SAU (AB)' : 'BÌNH THƯỜNG';
        abEl.className = airplane.throttle > 0.85 ? 'warn' : 'off';

        const stateEl = document.getElementById('sys-flight-state');
        if (airplane.isCrashed) {
            stateEl.textContent = 'ĐÃ PHÁ HỦY - ĐANG HỒI SINH';
            stateEl.className = 'warn';
        } else if (airplane.isStalling) {
            stateEl.textContent = '⚠️ THẤT TỐC (STALL)';
            stateEl.className = 'warn';
        } else if (airplane.onGround) {
            stateEl.textContent = knots > 8 ? 'ĐANG LĂN BÁNH ĐƯỜNG BĂNG' : 'ĐỖ TRÊN MẶT ĐẤT';
            stateEl.className = 'on';
        } else {
            stateEl.textContent = GAME.gravityG <= 0 ? 'BAY PHI TRỌNG LỰC' : 'ĐANG BAY ỔN ĐỊNH';
            stateEl.className = 'on';
        }

        drawArtificialHorizon();
        drawCompass();
        drawMinimap();
    }

    function drawArtificialHorizon() {
        const w = horizonCanvas.width, h = horizonCanvas.height;
        const cx = w / 2, cy = h / 2;
        hCtx.clearRect(0, 0, w, h);

        hCtx.save();
        hCtx.strokeStyle = 'rgba(0, 255, 170, 0.82)';
        hCtx.fillStyle = 'rgba(0, 255, 170, 0.88)';
        hCtx.lineWidth = 1.6;
        hCtx.font = 'bold 11px Consolas, monospace';

        // Tâm máy bay cố định (Aircraft Bore Sight Symbol)
        hCtx.beginPath();
        hCtx.moveTo(cx - 28, cy);
        hCtx.lineTo(cx - 9, cy);
        hCtx.lineTo(cx - 5, cy + 6);
        hCtx.moveTo(cx + 28, cy);
        hCtx.lineTo(cx + 9, cy);
        hCtx.lineTo(cx + 5, cy + 6);
        hCtx.stroke();
        hCtx.fillRect(cx - 1.5, cy - 1.5, 3, 3);

        // Thang góc chúc/ngóc (Pitch Ladder) xoay theo góc nghiêng cánh (Roll)
        hCtx.save();
        hCtx.translate(cx, cy);
        hCtx.rotate(THREE.MathUtils.degToRad(-airplane.rollDeg));

        const pxPerDeg = 3.6;
        const pitchOffset = airplane.pitchDeg * pxPerDeg;

        // Đường chân trời chính (0 độ)
        hCtx.beginPath();
        hCtx.moveTo(-95, pitchOffset);
        hCtx.lineTo(-32, pitchOffset);
        hCtx.moveTo(32, pitchOffset);
        hCtx.lineTo(95, pitchOffset);
        hCtx.stroke();

        // Các vạch thang Pitch từ -30° đến +30°
        for (let deg = -30; deg <= 30; deg += 10) {
            if (deg === 0) continue;
            const y = pitchOffset - deg * pxPerDeg;
            if (Math.abs(y) > 105) continue;

            hCtx.beginPath();
            if (deg < 0) hCtx.setLineDash([5, 4]);
            else hCtx.setLineDash([]);

            hCtx.moveTo(-42, y);
            hCtx.lineTo(-16, y);
            hCtx.lineTo(-16, y + (deg > 0 ? 5 : -5));

            hCtx.moveTo(42, y);
            hCtx.lineTo(16, y);
            hCtx.lineTo(16, y + (deg > 0 ? 5 : -5));
            hCtx.stroke();

            hCtx.setLineDash([]);
            hCtx.fillText(`${deg}`, -64, y + 4);
            hCtx.fillText(`${deg}`, 46, y + 4);
        }
        hCtx.restore();
        hCtx.restore();
    }

    function drawCompass() {
        const w = compassCanvas.width, h = compassCanvas.height;
        cCtx.clearRect(0, 0, w, h);

        const cx = w / 2;
        const hdg = airplane.headingDeg;
        const pxPerDeg = 3.2;

        cCtx.strokeStyle = 'rgba(56, 189, 248, 0.75)';
        cCtx.fillStyle = '#e2e8f0';
        cCtx.font = 'bold 11px Consolas, monospace';
        cCtx.textAlign = 'center';

        const cardinals = { 0: 'BẮC (N)', 45: 'ĐB', 90: 'ĐÔNG (E)', 135: 'ĐN', 180: 'NAM (S)', 225: 'TN', 270: 'TÂY (W)', 315: 'TB' };

        for (let offset = -50; offset <= 50; offset++) {
            let deg = (Math.floor(hdg) + offset + 360) % 360;
            const x = cx + (offset - (hdg - Math.floor(hdg))) * pxPerDeg;

            if (deg % 5 === 0) {
                const isMajor = deg % 15 === 0;
                cCtx.beginPath();
                cCtx.moveTo(x, h);
                cCtx.lineTo(x, h - (isMajor ? 11 : 6));
                cCtx.stroke();

                if (cardinals[deg]) {
                    cCtx.fillStyle = '#00ffaa';
                    cCtx.fillText(cardinals[deg], x, 16);
                } else if (deg % 30 === 0) {
                    cCtx.fillStyle = '#94a3b8';
                    cCtx.fillText(`${deg}°`, x, 16);
                }
            }
        }

        // Con trỏ hướng hiện tại ở chính giữa
        cCtx.fillStyle = '#fbbf24';
        cCtx.beginPath();
        cCtx.moveTo(cx, h - 14);
        cCtx.lineTo(cx - 5, h - 2);
        cCtx.lineTo(cx + 5, h - 2);
        cCtx.closePath();
        cCtx.fill();
    }

    function drawMinimap() {
        const w = minimapCanvas.width, h = minimapCanvas.height;
        const cx = w / 2, cy = h / 2;
        const scale = 0.032; // Tỉ lệ thu phóng bản đồ

        mCtx.fillStyle = '#071526';
        mCtx.fillRect(0, 0, w, h);

        const toMap = (wx, wz) => ({
            x: cx + (wx - airplane.pos.x) * scale,
            y: cy + (wz - airplane.pos.z) * scale
        });

        // 1. Vẽ dòng sông trên mini-map
        mCtx.strokeStyle = '#0284c7';
        mCtx.lineWidth = 6;
        mCtx.beginPath();
        for (let wx = -3500; wx <= 3500; wx += 250) {
            const p = toMap(wx, getRiverCenterZ(wx));
            if (wx === -3500) mCtx.moveTo(p.x, p.y);
            else mCtx.lineTo(p.x, p.y);
        }
        mCtx.stroke();

        // 2. Vẽ khu vực Thành phố
        const cityP = toMap(CONFIG.cityCenterX, CONFIG.cityCenterZ);
        mCtx.fillStyle = 'rgba(148, 163, 184, 0.28)';
        mCtx.strokeStyle = 'rgba(56, 189, 248, 0.5)';
        mCtx.lineWidth = 1;
        const citySize = 1050 * scale;
        mCtx.fillRect(cityP.x - citySize / 2, cityP.y - citySize / 2, citySize, citySize);
        mCtx.strokeRect(cityP.x - citySize / 2, cityP.y - citySize / 2, citySize, citySize);

        // 3. Vẽ Đường băng sân bay (RWY 09/27) & Đường kéo dài hỗ trợ ngắm hạ cánh
        const rwyStart = toMap(CONFIG.runwayX - CONFIG.runwayLength / 2, CONFIG.runwayZ);
        const rwyEnd = toMap(CONFIG.runwayX + CONFIG.runwayLength / 2, CONFIG.runwayZ);

        mCtx.strokeStyle = 'rgba(0, 255, 170, 0.35)';
        mCtx.setLineDash([3, 3]);
        mCtx.beginPath();
        const extStart = toMap(CONFIG.runwayX - 2400, CONFIG.runwayZ);
        const extEnd = toMap(CONFIG.runwayX + 2400, CONFIG.runwayZ);
        mCtx.moveTo(extStart.x, extStart.y);
        mCtx.lineTo(extEnd.x, extEnd.y);
        mCtx.stroke();
        mCtx.setLineDash([]);

        mCtx.strokeStyle = '#f8fafc';
        mCtx.lineWidth = 4;
        mCtx.beginPath();
        mCtx.moveTo(rwyStart.x, rwyStart.y);
        mCtx.lineTo(rwyEnd.x, rwyEnd.y);
        mCtx.stroke();

        // 4. Vẽ biểu tượng máy bay của người chơi ở tâm Mini-map
        mCtx.save();
        mCtx.translate(cx, cy);
        mCtx.rotate(THREE.MathUtils.degToRad(airplane.headingDeg));
        mCtx.fillStyle = '#00ffaa';
        mCtx.beginPath();
        mCtx.moveTo(0, -8);
        mCtx.lineTo(6, 6);
        mCtx.lineTo(0, 3);
        mCtx.lineTo(-6, 6);
        mCtx.closePath();
        mCtx.fill();
        mCtx.restore();

        document.getElementById('minimap-coords').textContent =
            `X:${Math.round(airplane.pos.x)} Z:${Math.round(airplane.pos.z)}`;
    }

    // ============================================================================
    // 16. QUẢN LÝ CHẤT LƯỢNG ĐỒ HỌA, SỰ KIỆN NÚT BẤM & VÒNG LẶP CHÍNH
    // ============================================================================
    function applyQualityPreset(quality) {
        GAME.quality = quality;
        const qLabels = { low: 'Thấp', medium: 'Trung bình', high: 'Cao' };
        document.getElementById('btn-quality').textContent = `✨ Đồ họa: ${qLabels[quality]}`;

        document.querySelectorAll('.quality-opt').forEach(btn => {
            btn.classList.toggle('active', btn.getAttribute('data-q') === quality);
        });

        if (quality === 'low') {
            renderer.setPixelRatio(1.0);
            renderer.shadowMap.enabled = false;
            if (grassInst) grassInst.visible = false;
            if (treeCrownInst) treeCrownInst.count = 900;
            if (treeTrunkInst) treeTrunkInst.count = 900;
        } else if (quality === 'medium') {
            renderer.setPixelRatio(Math.min(window.devicePixelRatio, 1.4));
            renderer.shadowMap.enabled = true;
            if (grassInst) grassInst.visible = true;
            if (treeCrownInst) treeCrownInst.count = 1600;
            if (treeTrunkInst) treeTrunkInst.count = 1600;
        } else {
            renderer.setPixelRatio(Math.min(window.devicePixelRatio, 2.0));
            renderer.shadowMap.enabled = true;
            if (grassInst) grassInst.visible = true;
            if (treeCrownInst) treeCrownInst.count = 2600;
            if (treeTrunkInst) treeTrunkInst.count = 2600;
        }
        renderer.setSize(window.innerWidth, window.innerHeight);
    }

    function setTimeMode(mode) {
        GAME.timeMode = mode;
        const mapT = { day: 0.0, sunset: 0.5, night: 1.0 };
        const labels = {
            day: '☀️ Ban ngày (14:00)',
            sunset: '🌇 Hoàng hôn (18:15)',
            night: '🌃 Ban đêm (23:00)'
        };
        GAME.targetTimeTransition = mapT[mode];
        document.getElementById('hud-time-label').textContent = labels[mode];

        document.querySelectorAll('.time-opt').forEach(btn => {
            btn.classList.toggle('active', btn.getAttribute('data-t') === mode);
        });
    }

    function cycleTimeOfDay() {
        const order = ['day', 'sunset', 'night'];
        const next = order[(order.indexOf(GAME.timeMode) + 1) % order.length];
        setTimeMode(next);
    }

    function cycleCameraMode() {
        GAME.cameraMode = (GAME.cameraMode + 1) % 3;
        const names = ['Sau lưng', 'Buồng lái', 'Ngoài (Kéo chuột)'];
        document.getElementById('hud-cam-mode').textContent = `🎥 Camera: ${names[GAME.cameraMode]}`;
    }

    function toggleMouseSteer() {
        GAME.mouseSteer = !GAME.mouseSteer;
        const btn = document.getElementById('btn-mouse-steer');
        btn.classList.toggle('active', GAME.mouseSteer);
        btn.textContent = GAME.mouseSteer ? '🖱️ Lái chuột: BẬT' : '🖱️ Lái chuột (M)';
        showHudAlert(GAME.mouseSteer ? 'ĐÃ BẬT LÁI MÁY BAY BẰNG CHUỘT' : 'ĐÃ TẮT LÁI BẰNG CHUỘT', 'info', 1.4);
    }

    function togglePauseMenu(forceState) {
        GAME.paused = typeof forceState === 'boolean' ? forceState : !GAME.paused;
        document.getElementById('modal-overlay').style.display = GAME.paused ? 'flex' : 'none';
        if (!GAME.paused) {
            sound.init();
            GAME.clock.getDelta();
        }
    }

    function setupUIEvents() {
        document.getElementById('btn-start-game').addEventListener('click', () => {
            togglePauseMenu(false);
        });

        document.getElementById('btn-spawn-air').addEventListener('click', () => {
            respawnPlane(true);
            togglePauseMenu(false);
        });

        document.getElementById('btn-pause').addEventListener('click', () => togglePauseMenu());
        document.getElementById('btn-time').addEventListener('click', () => cycleTimeOfDay());
        document.getElementById('btn-camera').addEventListener('click', () => cycleCameraMode());
        document.getElementById('btn-mouse-steer').addEventListener('click', () => toggleMouseSteer());
        document.getElementById('btn-respawn').addEventListener('click', () => respawnPlane(false));

        document.getElementById('btn-quality').addEventListener('click', () => {
            const order = ['low', 'medium', 'high'];
            const next = order[(order.indexOf(GAME.quality) + 1) % order.length];
            applyQualityPreset(next);
        });

        document.getElementById('btn-audio').addEventListener('click', (e) => {
            sound.init();
            sound.enabled = !sound.enabled;
            e.target.textContent = sound.enabled ? '🔊 Âm thanh: Bật' : '🔇 Âm thanh: Tắt';
        });

        document.querySelectorAll('.quality-opt').forEach(btn => {
            btn.addEventListener('click', () => applyQualityPreset(btn.getAttribute('data-q')));
        });

        document.querySelectorAll('.time-opt').forEach(btn => {
            btn.addEventListener('click', () => setTimeMode(btn.getAttribute('data-t')));
        });

        document.getElementById('modal-touch-toggle').addEventListener('click', (e) => {
            const tc = document.getElementById('touch-controls');
            tc.classList.toggle('enabled');
            e.target.textContent = tc.classList.contains('enabled')
                ? '📱 Joystick Cảm ứng: BẬT'
                : '📱 Joystick Cảm ứng: Tự động';
        });

        // Thanh trượt & Các nút chọn nhanh Trọng lực
        const gravSlider = document.getElementById('gravity-slider');
        gravSlider.addEventListener('input', (e) => {
            setGravityTarget(e.target.value);
        });

        document.querySelectorAll('.grav-btn').forEach(btn => {
            btn.addEventListener('click', () => {
                setGravityTarget(btn.getAttribute('data-g'));
            });
        });

        window.addEventListener('resize', () => {
            camera.aspect = window.innerWidth / window.innerHeight;
            camera.updateProjectionMatrix();
            renderer.setSize(window.innerWidth, window.innerHeight);
        });
    }

    // ============================================================================
    // 17. KHỞI CHẠY TOÀN BỘ THẾ GIỚI & VÒNG LẶP RENDER 60 FPS
    // ============================================================================
    let elapsedTotal = 0;

    function animate() {
        requestAnimationFrame(animate);

        const rawDt = GAME.clock.getDelta();
        const dt = Math.min(rawDt, 0.05);

        // Đo FPS và tự động tối ưu PixelRatio nếu máy yếu
        GAME.frameCount++;
        GAME.fpsTimer += rawDt;
        if (GAME.fpsTimer >= 0.5) {
            GAME.fps = Math.round(GAME.frameCount / GAME.fpsTimer);
            document.getElementById('hud-fps').textContent = `${GAME.fps} FPS`;
            if (GAME.fps < 32 && renderer.getPixelRatio() > 1.0) {
                renderer.setPixelRatio(1.0);
            }
            GAME.frameCount = 0;
            GAME.fpsTimer = 0;
        }

        if (!GAME.paused) {
            elapsedTotal += dt;
            updateFlightPhysics(dt);
            updateTraffic(dt);
            updateParticles(dt);
        }

        updateEnvironmentAndLights(dt, elapsedTotal);
        updateCamera(dt);
        updateHUD(dt);
        sound.update(airplane.throttle, airplane.speedMs, airplane.isStalling, airplane.isCrashed, GAME.paused);

        renderer.render(scene, camera);
    }

    // Khởi tạo toàn bộ thế giới 3D
    buildTerrain();
    buildVegetationAndClouds();
    buildAirport();
    buildCityAndSuburbs();
    buildAirplaneModel();
    initParticleSystem();
    setupControls();
    setupUIEvents();
    respawnPlane(false);
    animate();
    </script>
</body>
