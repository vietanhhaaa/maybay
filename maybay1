    function updateTraffic(dt) {
        if (!carInstMesh) return;
        const dummy = new THREE.Object3D();
        const cx = CONFIG.cityCenterX;
        const cz = CONFIG.cityCenterZ;
        const gMs2 = GAME.gravityG * CONFIG.gravityEarth;

        for (let i = 0; i < trafficCars.length; i++) {
            const c = trafficCars[i];
            if (c.alongX) {
                c.x += c.speed * dt;
                if (c.x > cx + 490) c.x = cx - 490;
                if (c.x < cx - 490) c.x = cx + 490;
            } else {
                c.z += c.speed * dt;
                if (c.z > cz + 490) c.z = cz - 490;
                if (c.z < cz - 490) c.z = cz + 490;
            }

            const groundY = getTerrainHeight(c.x, c.z) + 0.85;

            // Khi trọng lực <= 0, xe cộ lơ lửng hoặc bị hút ngược lên trời!
            if (GAME.gravityG <= 0.02) {
                const upAccel = GAME.gravityG < 0 ? (-gMs2 * 0.35) : 1.2;
                c.vy += upAccel * dt;
                c.y += c.vy * dt;
                if (c.y > groundY + 180) {
                    c.y = groundY + 180;
                    c.vy *= -0.3;
                }
                c.rotX += c.spinX * dt;
                c.rotZ += c.spinZ * dt;
            } else {
                // Trọng lực dương: xe rơi về mặt đường
                c.vy -= gMs2 * dt;
                c.y += c.vy * dt;
                if (c.y <= groundY) {
                    c.y = groundY;
                    c.vy = 0;
                    c.rotX = MathUtils.lerp(c.rotX, 0, dt * 8);
                    c.rotZ = MathUtils.lerp(c.rotZ, 0, dt * 8);
                }
            }

            dummy.position.set(c.x, c.y, c.z);
            const yaw = c.alongX ? (c.speed > 0 ? Math.PI / 2 : -Math.PI / 2) : (c.speed > 0 ? 0 : Math.PI);
            dummy.rotation.set(c.rotX, yaw, c.rotZ);
            dummy.updateMatrix();
            carInstMesh.setMatrixAt(i, dummy.matrix);
            carHeadlightInst.setMatrixAt(i, dummy.matrix);
        }
        carInstMesh.instanceMatrix.needsUpdate = true;
        carHeadlightInst.instanceMatrix.needsUpdate = true;
    }

