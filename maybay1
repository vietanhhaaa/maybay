    <!-- Thư viện Three.js từ CDN -->
    <script src="https://cdnjs.cloudflare.com/ajax/libs/three.js/r128/three.min.js"></script>
    <script>
    /**
     * ============================================================================
     * AERO-G: MÔ PHỎNG BAY 3D & ĐIỀU KHIỂN TRỌNG LỰC
     * Toàn bộ mã nguồn được chia thành các phân hệ rõ ràng, chú thích tiếng Việt.
     * ============================================================================
     */

    // ============================================================================
    // 1. CẤU HÌNH TOÀN CỤC & TRẠNG THÁI TRÒ CHƠI
    // ============================================================================
    const CONFIG = {
        worldSize: 16000,
        runwayX: -1200,
        runwayZ: 400,
        runwayLength: 1500,
        runwayWidth: 54,
        cityCenterX: 650,
        cityCenterZ: -550,
        suburbCenterX: -250,
        suburbCenterZ: -750,
        riverZOffset: -120,
        waterLevel: 0.0,
        baseTerrainY: 4.5, // Độ cao mặt phẳng sân bay & thành phố
        gravityEarth: 9.81
    };

    const GAME = {
        paused: true,
        quality: 'high', // 'low', 'medium', 'high'
        timeMode: 'day', // 'day', 'sunset', 'night'
        timeTransition: 0, // 0: Ngày, 0.5: Hoàng hôn, 1.0: Đêm
        targetTimeTransition: 0,
        gravityG: 1.0,
        targetGravityG: 1.0,
        cameraMode: 0, // 0: Sau lưng (Follow), 1: Buồng lái (Cockpit), 2: Điện ảnh / Orbit
        mouseSteer: false,
        mouseX: 0,
        mouseY: 0,
        orbitAngleX: 0.45,
        orbitAngleY: 0.25,
        fps: 60,
        frameCount: 0,
        fpsTimer: 0,
        alertTimer: 0,
        clock: new THREE.Clock()
    };

    // ============================================================================
    // 2. HÀM TOÁN HỌC & NHIỄU ĐỊA HÌNH (PROCEDURAL NOISE)
    // ============================================================================
    const MathUtils = {
        clamp: (v, min, max) => Math.max(min, Math.min(max, v)),
        lerp: (a, b, t) => a + (b - a) * t,
        smoothstep: (edge0, edge1, x) => {
            const t = Math.max(0, Math.min(1, (x - edge0) / (edge1 - edge0)));
            return t * t * (3 - 2 * t);
        },
        hash2D: (x, z) => {
            const n = Math.sin(x * 127.1 + z * 311.7) * 43758.5453123;
            return n - Math.floor(n);
        },
        noise2D(x, z) {
            const xi = Math.floor(x), zi = Math.floor(z);
            const xf = x - xi, zf = z - zi;
            const u = xf * xf * (3 - 2 * xf);
            const v = zf * zf * (3 - 2 * zf);
            const a = this.hash2D(xi, zi);
            const b = this.hash2D(xi + 1, zi);
            const c = this.hash2D(xi, zi + 1);
            const d = this.hash2D(xi + 1, zi + 1);
            return this.lerp(this.lerp(a, b, u), this.lerp(c, d, u), v);
        },
        fbm(x, z, octaves = 4) {
            let val = 0, amp = 0.5, freq = 1;
            for (let i = 0; i < octaves; i++) {
                val += amp * this.noise2D(x * freq, z * freq);
                freq *= 2.03;
                amp *= 0.5;
            }
            return val;
        }
    };

    /**
     * Hàm tính độ cao địa hình (Terrain Heightmap) tại tọa độ (x, z) bất kỳ.
     * Đảm bảo vùng sân bay và trung tâm thành phố bằng phẳng, có dòng sông chảy qua,
     * xung quanh là đồi ngoại ô và dãy núi hùng vĩ.
     */
    function getTerrainHeight(x, z) {
        // Khoảng cách tới sân bay (hình hộp chữ nhật mở rộng)
        const dxRwy = Math.max(0, Math.abs(x - CONFIG.runwayX) - (CONFIG.runwayLength * 0.65));
        const dzRwy = Math.max(0, Math.abs(z - CONFIG.runwayZ) - 360);
        const distRwy = Math.hypot(dxRwy, dzRwy);
        const rwyFlatMask = MathUtils.smoothstep(0, 420, distRwy);

        // Khoảng cách tới thành phố & ngoại ô
        const distCity = Math.hypot(x - CONFIG.cityCenterX, z - CONFIG.cityCenterZ);
        const cityFlatMask = MathUtils.smoothstep(550, 1250, distCity);

        const distSuburb = Math.hypot(x - CONFIG.suburbCenterX, z - CONFIG.suburbCenterZ);
        const suburbFlatMask = MathUtils.smoothstep(320, 750, distSuburb);

        // Dòng sông uốn lượn chảy giữa sân bay và thành phố
        const riverCurveZ = CONFIG.riverZOffset + Math.sin(x * 0.0014) * 180 + Math.cos(x * 0.0005) * 90;
        const distRiver = Math.abs(z - riverCurveZ);
        const riverMask = 1.0 - MathUtils.smoothstep(45, 135, distRiver);

        // Độ cao đồi núi tự nhiên bằng FBM
        const n1 = MathUtils.fbm(x * 0.00045 + 10.5, z * 0.00045 + 22.1, 4);
        const n2 = MathUtils.fbm(x * 0.0012 - 5.2, z * 0.0012 + 8.7, 3);
        let mountainFactor = Math.pow(Math.max(0, n1 - 0.34) * 1.55, 2.15) * 620 + n2 * 42;

        // Dãy núi cao hơn ở phía Bắc (z < -1300) và phía Đông/Tây xa
        const radialDist = Math.hypot(x, z);
        const ringBoost = MathUtils.smoothstep(1400, 3600, radialDist) * 260;
        let rawHeight = CONFIG.baseTerrainY + (mountainFactor + ringBoost) * rwyFlatMask * cityFlatMask * (0.25 + 0.75 * suburbFlatMask);

        // Hạ thấp lòng sông xuống dưới mực nước biển
        rawHeight = MathUtils.lerp(rawHeight, -7.5, riverMask * rwyFlatMask);

        // Bờ biển phía Nam xa (z > 1900)
        const seaFade = MathUtils.smoothstep(1700, 2700, z);
        rawHeight = MathUtils.lerp(rawHeight, -9.0, seaFade);

        return rawHeight;
    }

    function getRiverCenterZ(x) {
        return CONFIG.riverZOffset + Math.sin(x * 0.0014) * 180 + Math.cos(x * 0.0005) * 90;
    }

    // ============================================================================
    // 3. HỆ THỐNG ÂM THANH WEB AUDIO API (KHÔNG DÙNG FILE NGOÀI)
    // ============================================================================
    class SoundEngine {
        constructor() {
            this.ctx = null;
            this.enabled = true;
            this.initialized = false;
            this.turbineOsc = null;
            this.rumbleGain = null;
            this.turbineGain = null;
            this.windGain = null;
            this.windFilter = null;
            this.abGain = null;
            this.stallOsc = null;
            this.stallGain = null;
        }

        init() {
            if (this.initialized) return;
            try {
                const AudioCtx = window.AudioContext || window.webkitAudioContext;
                this.ctx = new AudioCtx();

                // Tạo buffer tiếng ồn trắng / hồng cho động cơ phản lực & gió
                const bufferSize = this.ctx.sampleRate * 2;
                const noiseBuffer = this.ctx.createBuffer(1, bufferSize, this.ctx.sampleRate);
                const data = noiseBuffer.getChannelData(0);
                let b0 = 0, b1 = 0, b2 = 0;
                for (let i = 0; i < bufferSize; i++) {
                    const white = Math.random() * 2 - 1;
                    b0 = 0.997 * b0 + white * 0.029;
                    b1 = 0.985 * b1 + white * 0.032;
                    b2 = 0.950 * b2 + white * 0.048;
                    data[i] = (b0 + b1 + b2 + white * 0.18) * 0.7;
                }

                // 1. Tiếng gầm buồng đốt phản lực (Rumble)
                const rumbleSource = this.ctx.createBufferSource();
                rumbleSource.buffer = noiseBuffer;
                rumbleSource.loop = true;
                this.rumbleFilter = this.ctx.createBiquadFilter();
                this.rumbleFilter.type = 'lowpass';
                this.rumbleFilter.frequency.value = 180;
                this.rumbleGain = this.ctx.createGain();
                this.rumbleGain.gain.value = 0.0;
                rumbleSource.connect(this.rumbleFilter);
                this.rumbleFilter.connect(this.rumbleGain);
                this.rumbleGain.connect(this.ctx.destination);
                rumbleSource.start();

                // 2. Tiếng rít cánh quạt tuabin cao tần (Turbine Whine)
                this.turbineOsc = this.ctx.createOscillator();
                this.turbineOsc.type = 'sawtooth';
                this.turbineOsc.frequency.value = 160;
                const turbineFilter = this.ctx.createBiquadFilter();
                turbineFilter.type = 'bandpass';
                turbineFilter.frequency.value = 500;
                turbineFilter.Q.value = 3.5;
                this.turbineGain = this.ctx.createGain();
                this.turbineGain.gain.value = 0.0;
                this.turbineOsc.connect(turbineFilter);
                turbineFilter.connect(this.turbineGain);
                this.turbineGain.connect(this.ctx.destination);
                this.turbineOsc.start();

                // 3. Tiếng gió lướt qua thân máy bay (Aerodynamic Wind)
                const windSource = this.ctx.createBufferSource();
                windSource.buffer = noiseBuffer;
                windSource.loop = true;
                this.windFilter = this.ctx.createBiquadFilter();
                this.windFilter.type = 'bandpass';
                this.windFilter.frequency.value = 400;
                this.windFilter.Q.value = 1.2;
                this.windGain = this.ctx.createGain();
                this.windGain.gain.value = 0.0;
                windSource.connect(this.windFilter);
                this.windFilter.connect(this.windGain);
                this.windGain.connect(this.ctx.destination);
                windSource.start();

                // 4. Còi báo thất tốc (Stall Warning Horn)
                this.stallOsc = this.ctx.createOscillator();
                this.stallOsc.type = 'square';
                this.stallOsc.frequency.value = 880;
                this.stallGain = this.ctx.createGain();
                this.stallGain.gain.value = 0.0;
                this.stallOsc.connect(this.stallGain);
                this.stallGain.connect(this.ctx.destination);
                this.stallOsc.start();

                this.initialized = true;
            } catch (e) {
                console.warn('Không thể khởi tạo Web Audio API:', e);
            }
        }

        update(throttle, speedMs, isStalling, isCrashed, paused) {
            if (!this.initialized || !this.ctx) return;
            if (paused || !this.enabled || isCrashed) {
                const now = this.ctx.currentTime;
                this.rumbleGain.gain.setTargetAtTime(0, now, 0.08);
                this.turbineGain.gain.setTargetAtTime(0, now, 0.08);
                this.windGain.gain.setTargetAtTime(0, now, 0.08);
                this.stallGain.gain.setTargetAtTime(0, now, 0.05);
                return;
            }

            if (this.ctx.state === 'suspended') this.ctx.resume();
            const now = this.ctx.currentTime;

            // Âm thanh động cơ theo % ga & đốt sau (Afterburner > 0.85)
            const abBoost = throttle > 0.85 ? (throttle - 0.85) * 4.0 : 0;
            this.rumbleFilter.frequency.setTargetAtTime(140 + throttle * 380 + abBoost * 320, now, 0.06);
            this.rumbleGain.gain.setTargetAtTime(0.05 + throttle * 0.22 + abBoost * 0.12, now, 0.06);

            this.turbineOsc.frequency.setTargetAtTime(170 + throttle * 460, now, 0.06);
            this.turbineGain.gain.setTargetAtTime(0.012 + throttle * 0.032, now, 0.06);

            // Âm thanh gió theo vận tốc bay
            const speedRatio = MathUtils.clamp(speedMs / 180, 0, 1.5);
            this.windFilter.frequency.setTargetAtTime(280 + speedRatio * 950, now, 0.08);
            this.windGain.gain.setTargetAtTime(speedRatio * 0.16, now, 0.08);

            // Còi báo thất tốc bíp ngắt quãng
            if (isStalling) {
                const beep = Math.sin(performance.now() * 0.028) > 0 ? 0.06 : 0.0;
                this.stallGain.gain.setTargetAtTime(beep, now, 0.015);
            } else {
                this.stallGain.gain.setTargetAtTime(0, now, 0.04);
            }
        }

        playExplosion() {
            if (!this.initialized || !this.enabled || !this.ctx) return;
            const now = this.ctx.currentTime;
            const osc = this.ctx.createOscillator();
            const gain = this.ctx.createGain();
            osc.type = 'sawtooth';
            osc.frequency.setValueAtTime(130, now);
            osc.frequency.exponentialRampToValueAtTime(22, now + 1.1);
            gain.gain.setValueAtTime(0.45, now);
            gain.gain.exponentialRampToValueAtTime(0.001, now + 1.2);
            osc.connect(gain);
            gain.connect(this.ctx.destination);
            osc.start(now);
            osc.stop(now + 1.25);
        }

        playTouchdown() {
            if (!this.initialized || !this.enabled || !this.ctx) return;
            const now = this.ctx.currentTime;
            const osc = this.ctx.createOscillator();
            const gain = this.ctx.createGain();
            osc.type = 'triangle';
            osc.frequency.setValueAtTime(520, now);
            osc.frequency.exponentialRampToValueAtTime(190, now + 0.25);
            gain.gain.setValueAtTime(0.14, now);
            gain.gain.exponentialRampToValueAtTime(0.001, now + 0.28);
            osc.connect(gain);
            gain.connect(this.ctx.destination);
            osc.start(now);
            osc.stop(now + 0.3);
        }

        playGravityShift() {
            if (!this.initialized || !this.enabled || !this.ctx) return;
            const now = this.ctx.currentTime;
            const osc = this.ctx.createOscillator();
            const gain = this.ctx.createGain();
            osc.type = 'sine';
            osc.frequency.setValueAtTime(220, now);
            osc.frequency.exponentialRampToValueAtTime(480, now + 0.35);
            gain.gain.setValueAtTime(0.12, now);
            gain.gain.exponentialRampToValueAtTime(0.001, now + 0.38);
            osc.connect(gain);
            gain.connect(this.ctx.destination);
            osc.start(now);
            osc.stop(now + 0.4);
        }
    }

    const sound = new SoundEngine();

    // ============================================================================
    // 4. TẠO TEXTURE THUẬT TOÁN (PROCEDURAL CANVAS TEXTURES)
    // ============================================================================
    const Textures = {
        // Tạo texture cửa sổ nhà cao tầng (cả diffuse ban ngày và emissive phát sáng ban đêm)
        createBuildingTextures() {
            const diffCanvas = document.createElement('canvas');
            diffCanvas.width = 256;
            diffCanvas.height = 512;
            const dCtx = diffCanvas.getContext('2d');

            const emisCanvas = document.createElement('canvas');
            emisCanvas.width = 256;
            emisCanvas.height = 512;
            const eCtx = emisCanvas.getContext('2d');

            dCtx.fillStyle = '#334155';
            dCtx.fillRect(0, 0, 256, 512);
            eCtx.fillStyle = '#000000';
            eCtx.fillRect(0, 0, 256, 512);

            const cols = 8, rows = 24;
            const padX = 6, padY = 5;
            const cellW = 256 / cols, cellH = 512 / rows;

            for (let r = 0; r < rows; r++) {
                for (let c = 0; c < cols; c++) {
                    const x = c * cellW + padX;
                    const y = r * cellH + padY;
                    const w = cellW - padX * 2;
                    const h = cellH - padY * 2;

                    // Kính phản chiếu ban ngày
                    dCtx.fillStyle = Math.random() > 0.3 ? '#64748b' : '#475569';
                    dCtx.fillRect(x, y, w, h);

                    // Đèn cửa sổ phát sáng ban đêm
                    if (Math.random() > 0.36) {
                        const warmPalette = ['#fef08a', '#fde047', '#fed7aa', '#bae6fd', '#fbbf24'];
                        eCtx.fillStyle = warmPalette[Math.floor(Math.random() * warmPalette.length)];
                        eCtx.fillRect(x, y, w, h);
                    }
                }
            }

            const diffTex = new THREE.CanvasTexture(diffCanvas);
            diffTex.wrapS = diffTex.wrapT = THREE.RepeatWrapping;
            const emisTex = new THREE.CanvasTexture(emisCanvas);
            emisTex.wrapS = emisTex.wrapT = THREE.RepeatWrapping;
            return { diffTex, emisTex };
        },

        // Texture mặt đường băng hoàn chỉnh với vạch kẻ, piano keys và số hiệu 09 / 27
        createRunwayTexture() {
            const canvas = document.createElement('canvas');
            canvas.width = 2048;
            canvas.height = 256;
            const ctx = canvas.getContext('2d');

            // Nền nhựa đường asphalt sẫm
            ctx.fillStyle = '#1e242b';
            ctx.fillRect(0, 0, canvas.width, canvas.height);

            // Hạt nhám mặt đường và vết lốp máy bay ở hai đầu chạm đất
            for (let i = 0; i < 6000; i++) {
                ctx.fillStyle = Math.random() > 0.5 ? 'rgba(255,255,255,0.03)' : 'rgba(0,0,0,0.08)';
                ctx.fillRect(Math.random() * canvas.width, Math.random() * canvas.height, 3, 2);
            }
            ctx.fillStyle = 'rgba(10, 12, 15, 0.38)';
            ctx.fillRect(260, 75, 340, 106);
            ctx.fillRect(canvas.width - 600, 75, 340, 106);

            // Vạch biên trắng dọc 2 bên đường băng
            ctx.fillStyle = '#f1f5f9';
            ctx.fillRect(20, 12, canvas.width - 40, 6);
            ctx.fillRect(20, canvas.height - 18, canvas.width - 40, 6);

            // Vạch ngưỡng đường băng (Threshold Piano Keys) hai đầu
            for (let i = 0; i < 8; i++) {
                const y = 26 + i * 26;
                if (i === 3 || i === 4) continue;
                ctx.fillRect(35, y, 75, 16);
                ctx.fillRect(canvas.width - 110, y, 75, 16);
            }

            // Vạch tim đường băng đứt đoạn (Centerline)
            for (let x = 230; x < canvas.width - 230; x += 72) {
                ctx.fillRect(x, canvas.height / 2 - 4, 42, 8);
            }

            // Điểm ngắm chạm bánh (Aiming Point Markers)
            ctx.fillRect(330, 46, 95, 28);
            ctx.fillRect(330, canvas.height - 74, 95, 28);
            ctx.fillRect(canvas.width - 425, 46, 95, 28);
            ctx.fillRect(canvas.width - 425, canvas.height - 74, 95, 28);

            // Số hiệu đường băng "09" và "27"
            ctx.save();
            ctx.fillStyle = '#f8fafc';
            ctx.font = 'bold 54px Consolas, monospace';
            ctx.textAlign = 'center';
            ctx.textBaseline = 'middle';

            ctx.save();
            ctx.translate(165, canvas.height / 2);
            ctx.rotate(Math.PI / 2);
            ctx.fillText('09', 0, 0);
            ctx.restore();

            ctx.save();
            ctx.translate(canvas.width - 165, canvas.height / 2);
            ctx.rotate(-Math.PI / 2);
            ctx.fillText('27', 0, 0);
            ctx.restore();
            ctx.restore();

            const tex = new THREE.CanvasTexture(canvas);
            tex.anisotropy = 8;
            return tex;
        },

        // Texture hạt sáng mềm (Glow / Cloud / Smoke Sprite)
        createRadialSprite(innerColor, outerColor) {
            const canvas = document.createElement('canvas');
            canvas.width = 128;
            canvas.height = 128;
            const ctx = canvas.getContext('2d');
            const grad = ctx.createRadialGradient(64, 64, 2, 64, 64, 64);
            grad.addColorStop(0, innerColor);
            grad.addColorStop(0.45, outerColor);
            grad.addColorStop(1, 'rgba(0,0,0,0)');
            ctx.fillStyle = grad;
            ctx.fillRect(0, 0, 128, 128);
            return new THREE.CanvasTexture(canvas);
        }
    };


    // ============================================================================
    // 5. KHỞI TẠO THREE.JS, ÁNH SÁNG ĐIỆN ẢNH, BẦU TRỜI & MẶT NƯỚC
    // ============================================================================
    const container = document.getElementById('canvas-container');
    const scene = new THREE.Scene();
    scene.fog = new THREE.FogExp2(0x9ec5fe, 0.00018);

    const camera = new THREE.PerspectiveCamera(60, window.innerWidth / window.innerHeight, 0.4, 15000);
    const renderer = new THREE.WebGLRenderer({ antialias: true, powerPreference: 'high-performance' });
    renderer.setSize(window.innerWidth, window.innerHeight);
    renderer.setPixelRatio(Math.min(window.devicePixelRatio, 2));
    renderer.shadowMap.enabled = true;
    renderer.shadowMap.type = THREE.PCFSoftShadowMap;
    renderer.toneMapping = THREE.ACESFilmicToneMapping;
    renderer.toneMappingExposure = 1.08;
    renderer.outputEncoding = THREE.sRGBEncoding;
    container.appendChild(renderer.domElement);

    // Hệ thống ánh sáng mặt trời, bầu trời và môi trường
    const hemiLight = new THREE.HemisphereLight(0xdbeafe, 0x3f523a, 0.65);
    scene.add(hemiLight);

    const sunLight = new THREE.DirectionalLight(0xfffbeb, 1.35);
    sunLight.position.set(1600, 1250, -1400);
    sunLight.castShadow = true;
    sunLight.shadow.mapSize.width = 2048;
    sunLight.shadow.mapSize.height = 2048;
    sunLight.shadow.camera.near = 20;
    sunLight.shadow.camera.far = 3600;
    const shadowExtent = 340;
    sunLight.shadow.camera.left = -shadowExtent;
    sunLight.shadow.camera.right = shadowExtent;
    sunLight.shadow.camera.top = shadowExtent;
    sunLight.shadow.camera.bottom = -shadowExtent;
    sunLight.shadow.bias = -0.00035;
    scene.add(sunLight);
    scene.add(sunLight.target);

    const sunDir = new THREE.Vector3(0.55, 0.48, -0.68).normalize();

    // Bầu trời Shader (Atmospheric Scattering + Sun Corona + Night Stars)
    const skyUniforms = {
        uSunDir: { value: sunDir.clone() },
        uTopColor: { value: new THREE.Color(0x0b3c7c) },
        uHorizonColor: { value: new THREE.Color(0x93c5fd) },
        uSunColor: { value: new THREE.Color(0xfff7ed) },
        uNightFactor: { value: 0.0 }
    };

    const skyMat = new THREE.ShaderMaterial({
        uniforms: skyUniforms,
        side: THREE.BackSide,
        depthWrite: false,
        vertexShader: `
            varying vec3 vWorldPos;
            void main() {
                vec4 wp = modelMatrix * vec4(position, 1.0);
                vWorldPos = wp.xyz;
                gl_Position = projectionMatrix * viewMatrix * wp;
            }
        `,
        fragmentShader: `
            varying vec3 vWorldPos;
            uniform vec3 uSunDir;
            uniform vec3 uTopColor;
            uniform vec3 uHorizonColor;
            uniform vec3 uSunColor;
            uniform float uNightFactor;

            float hash(vec3 p) {
                p = fract(p * 0.3183099 + 0.1);
                p *= 17.0;
                return fract(p.x * p.y * p.z * (p.x + p.y + p.z));
            }

            void main() {
                vec3 dir = normalize(vWorldPos - cameraPosition);
                float h = clamp(dir.y, 0.0, 1.0);
                vec3 col = mix(uHorizonColor, uTopColor, pow(h, 0.58));

                // Quầng sáng mặt trời (Mie scattering + Sun disc)
                float sunAmt = max(dot(dir, uSunDir), 0.0);
                col += uSunColor * pow(sunAmt, 12.0) * 0.38;
                col += uSunColor * smoothstep(0.9982, 0.9997, sunAmt) * 2.6;

                // Ngôi sao lấp lánh ban đêm
                if (uNightFactor > 0.05 && dir.y > 0.02) {
                    float starNoise = hash(floor(dir * 420.0));
                    float star = smoothstep(0.9955, 0.9995, starNoise) * uNightFactor * smoothstep(0.02, 0.25, dir.y);
                    col += vec3(0.85, 0.92, 1.0) * star * 1.4;
                }

                gl_FragColor = vec4(col, 1.0);
            }
        `
    });
    const skyDome = new THREE.Mesh(new THREE.SphereGeometry(12500, 32, 20), skyMat);
    scene.add(skyDome);

    // Mặt nước (Sông & Biển) với Shader sóng động và phản chiếu ánh mặt trời
    const waterUniforms = {
        uTime: { value: 0 },
        uSunDir: { value: sunDir.clone() },
        uSunColor: { value: new THREE.Color(0xfffbeb) },
        uWaterDeep: { value: new THREE.Color(0x063455) },
        uWaterShallow: { value: new THREE.Color(0x0e6b8a) },
        uSkyHorizon: { value: new THREE.Color(0x93c5fd) }
    };

    const waterMat = new THREE.ShaderMaterial({
        uniforms: waterUniforms,
        transparent: true,
        vertexShader: `
            uniform float uTime;
            varying vec3 vWorldPos;
            varying float vWave;
            void main() {
                vec3 pos = position;
                vec4 wp = modelMatrix * vec4(pos, 1.0);
                float w1 = sin(wp.x * 0.035 + uTime * 1.8) * cos(wp.z * 0.03 + uTime * 1.3) * 0.35;
                float w2 = sin(wp.x * 0.09 - uTime * 2.4 + wp.z * 0.07) * 0.15;
                wp.y += w1 + w2;
                vWave = w1 + w2;
                vWorldPos = wp.xyz;
                gl_Position = projectionMatrix * viewMatrix * wp;
            }
        `,
        fragmentShader: `
            varying vec3 vWorldPos;
            varying float vWave;
            uniform float uTime;
            uniform vec3 uSunDir;
            uniform vec3 uSunColor;
            uniform vec3 uWaterDeep;
            uniform vec3 uWaterShallow;
            uniform vec3 uSkyHorizon;

            void main() {
                vec3 viewDir = normalize(cameraPosition - vWorldPos);
                // Vector pháp tuyến giả lập sóng gợn
                float nx = cos(vWorldPos.x * 0.14 + uTime * 2.2) * 0.08 + sin(vWorldPos.z * 0.19 - uTime * 1.7) * 0.05;
                float nz = sin(vWorldPos.z * 0.15 + uTime * 2.0) * 0.08 + cos(vWorldPos.x * 0.11 + uTime * 1.5) * 0.05;
                vec3 normal = normalize(vec3(nx, 1.0, nz));

                // Hiệu ứng Fresnel phản chiếu bầu trời
                float fresnel = pow(1.0 - max(dot(viewDir, normal), 0.0), 3.2);
                vec3 waterCol = mix(uWaterDeep, uWaterShallow, clamp(vWave + 0.5, 0.0, 1.0));
                vec3 col = mix(waterCol, uSkyHorizon, fresnel * 0.65);

                // Phản chiếu lấp lánh mặt trời (Specular Highlight)
                vec3 refl = reflect(-uSunDir, normal);
                float spec = pow(max(dot(viewDir, refl), 0.0), 96.0);
                col += uSunColor * spec * 1.65;

                gl_FragColor = vec4(col, 0.92);
            }
        `
    });
    const waterGeo = new THREE.PlaneGeometry(CONFIG.worldSize, CONFIG.worldSize, 128, 128);
    waterGeo.rotateX(-Math.PI / 2);
    const waterMesh = new THREE.Mesh(waterGeo, waterMat);
    waterMesh.position.y = CONFIG.waterLevel;
    scene.add(waterMesh);

    // ============================================================================
    // 6. TẠO ĐỊA HÌNH, RỪNG CÂY, CỎ & MÂY THỂ TÍCH (TERRAIN & VOLUMETRIC CLOUDS)
    // ============================================================================
    const colliders = []; // Danh sách các hộp va chạm (nhà cao tầng, tháp, nhà ga...)
    const dynamicLightMaterials = []; // Danh sách vật liệu phát sáng ban đêm

    function buildTerrain() {
        const segs = 220;
        const geo = new THREE.PlaneGeometry(CONFIG.worldSize, CONFIG.worldSize, segs, segs);
        geo.rotateX(-Math.PI / 2);
        const pos = geo.attributes.position;
        const colors = new Float32Array(pos.count * 3);

        const cSand = new THREE.Color(0xd6c79c);
        const cGrass = new THREE.Color(0x3f6a34);
        const cForest = new THREE.Color(0x2d4c28);
        const cRock = new THREE.Color(0x57534e);
        const cSnow = new THREE.Color(0xf1f5f9);
        const cCityGround = new THREE.Color(0x333942);
        const tmp = new THREE.Color();

        for (let i = 0; i < pos.count; i++) {
            const x = pos.getX(i);
            const z = pos.getZ(i);
            const y = getTerrainHeight(x, z);
            pos.setY(i, y);

            const distCity = Math.hypot(x - CONFIG.cityCenterX, z - CONFIG.cityCenterZ);
            if (y < 2.2) {
                tmp.copy(cSand);
            } else if (distCity < 620 && y < 12) {
                tmp.copy(cCityGround).lerp(cGrass, MathUtils.smoothstep(380, 620, distCity));
            } else if (y < 38) {
                tmp.copy(cGrass).lerp(cForest, MathUtils.clamp((y - 5) / 33, 0, 1));
            } else if (y < 155) {
                tmp.copy(cForest).lerp(cRock, MathUtils.clamp((y - 38) / 110, 0, 1));
            } else {
                tmp.copy(cRock).lerp(cSnow, MathUtils.clamp((y - 155) / 95, 0, 1));
            }

            colors[i * 3] = tmp.r;
            colors[i * 3 + 1] = tmp.g;
            colors[i * 3 + 2] = tmp.b;
        }

        geo.setAttribute('color', new THREE.BufferAttribute(colors, 3));
        geo.computeVertexNormals();

        const mat = new THREE.MeshStandardMaterial({
            vertexColors: true,
            roughness: 0.88,
            metalness: 0.04
        });
        const mesh = new THREE.Mesh(geo, mat);
        mesh.receiveShadow = true;
        scene.add(mesh);
    }

    // Tạo cây cối & thảm cỏ bằng InstancedMesh
    let treeCrownInst, treeTrunkInst, grassInst, cloudInst;

    function buildVegetationAndClouds() {
        const treeCount = 2600;
        const trunkGeo = new THREE.CylinderGeometry(0.45, 0.7, 3.5, 6);
        trunkGeo.translate(0, 1.75, 0);
        const trunkMat = new THREE.MeshStandardMaterial({ color: 0x5c4033, roughness: 0.9 });
        treeTrunkInst = new THREE.InstancedMesh(trunkGeo, trunkMat, treeCount);

        const crownGeo = new THREE.ConeGeometry(3.2, 8.5, 7);
        crownGeo.translate(0, 6.5, 0);
        const crownMat = new THREE.MeshStandardMaterial({ color: 0x2d5a27, roughness: 0.82 });
        treeCrownInst = new THREE.InstancedMesh(crownGeo, crownMat, treeCount);
        treeCrownInst.castShadow = true;
        treeCrownInst.receiveShadow = true;

        const dummy = new THREE.Object3D();
        const col = new THREE.Color();
        let placed = 0, attempts = 0;

        while (placed < treeCount && attempts < treeCount * 5) {
            attempts++;
            const x = (Math.random() - 0.5) * 6800;
            const z = (Math.random() - 0.5) * 6800;
            // Tránh đường băng và trung tâm thành phố
            if (Math.abs(x - CONFIG.runwayX) < 920 && Math.abs(z - CONFIG.runwayZ) < 280) continue;
            if (Math.hypot(x - CONFIG.cityCenterX, z - CONFIG.cityCenterZ) < 520) continue;

            const y = getTerrainHeight(x, z);
            if (y < 3.0 || y > 135) continue;

            const s = 0.75 + Math.random() * 1.15;
            dummy.position.set(x, y, z);
            dummy.rotation.set(0, Math.random() * Math.PI * 2, 0);
            dummy.scale.set(s, s * (0.85 + Math.random() * 0.4), s);
            dummy.updateMatrix();

            treeTrunkInst.setMatrixAt(placed, dummy.matrix);
            treeCrownInst.setMatrixAt(placed, dummy.matrix);
            col.setHSL(0.28 + (Math.random() - 0.5) * 0.06, 0.48, 0.24 + Math.random() * 0.1);
            treeCrownInst.setColorAt(placed, col);
            placed++;
        }
        treeTrunkInst.count = placed;
        treeCrownInst.count = placed;
        scene.add(treeTrunkInst);
        scene.add(treeCrownInst);

        // Thảm cỏ quanh sân bay và đồi
        const grassCount = 3500;
        const grassGeo = new THREE.ConeGeometry(0.65, 1.6, 4);
        grassGeo.translate(0, 0.8, 0);
        const grassMat = new THREE.MeshStandardMaterial({ color: 0x4d7c3f, roughness: 0.9 });
        grassInst = new THREE.InstancedMesh(grassGeo, grassMat, grassCount);
        let gPlaced = 0;
        for (let i = 0; i < grassCount * 2 && gPlaced < grassCount; i++) {
            const x = (Math.random() - 0.5) * 3800 - 300;
            const z = (Math.random() - 0.5) * 3800;
            if (Math.abs(x - CONFIG.runwayX) < 790 && Math.abs(z - CONFIG.runwayZ) < 70) continue;
            const y = getTerrainHeight(x, z);
            if (y < 3.5 || y > 45) continue;
            dummy.position.set(x, y, z);
            dummy.rotation.set(0, Math.random() * Math.PI, 0);
            dummy.scale.set(1 + Math.random(), 0.7 + Math.random() * 0.9, 1 + Math.random());
            dummy.updateMatrix();
            grassInst.setMatrixAt(gPlaced++, dummy.matrix);
        }
        grassInst.count = gPlaced;
        scene.add(grassInst);

        // Mây thể tích (Multi-puff Volumetric Cloud Clusters)
        const cloudPuffs = 520;
        const cloudGeo = new THREE.DodecahedronGeometry(1, 1);
        const cloudMat = new THREE.MeshStandardMaterial({
            color: 0xffffff,
            roughness: 0.95,
            metalness: 0.0,
            transparent: true,
            opacity: 0.86
        });
        cloudInst = new THREE.InstancedMesh(cloudGeo, cloudMat, cloudPuffs);
        let cIdx = 0;
        for (let c = 0; c < 65; c++) {
            const cx = (Math.random() - 0.5) * 10500;
            const cz = (Math.random() - 0.5) * 10500;
            const cy = 420 + Math.random() * 480;
            const puffsInCloud = 6 + Math.floor(Math.random() * 4);
            for (let p = 0; p < puffsInCloud && cIdx < cloudPuffs; p++) {
                dummy.position.set(
                    cx + (Math.random() - 0.5) * 180,
                    cy + (Math.random() - 0.5) * 32,
                    cz + (Math.random() - 0.5) * 150
                );
                dummy.rotation.set(Math.random(), Math.random(), Math.random());
                const sx = 55 + Math.random() * 65;
                const sy = 24 + Math.random() * 22;
                const sz = 48 + Math.random() * 55;
                dummy.scale.set(sx, sy, sz);
                dummy.updateMatrix();
                cloudInst.setMatrixAt(cIdx++, dummy.matrix);
            }
        }
        cloudInst.count = cIdx;
        scene.add(cloudInst);
    }

    // ============================================================================
    // 7. XÂY DỰNG SÂN BAY HOÀN CHỈNH (ĐƯỜNG BĂNG, THÁP, HANGAR, PAPI, CỘT GIÓ)
    // ============================================================================
    let beaconHead = null;
    let beaconBeam = null;
    let windsockCone = null;
    const papiLights = [];

    function buildAirport() {
        const y0 = CONFIG.baseTerrainY + 0.08;
        const rx = CONFIG.runwayX;
        const rz = CONFIG.runwayZ;

        // 1. Đường băng chính (Runway 09 / 27)
        const rwyTex = Textures.createRunwayTexture();
        const rwyGeo = new THREE.PlaneGeometry(CONFIG.runwayLength, CONFIG.runwayWidth);
        rwyGeo.rotateX(-Math.PI / 2);
        const rwyMat = new THREE.MeshStandardMaterial({
            map: rwyTex,
            roughness: 0.78,
            metalness: 0.08
        });
        const rwyMesh = new THREE.Mesh(rwyGeo, rwyMat);
        rwyMesh.position.set(rx, y0 + 0.05, rz);
        rwyMesh.receiveShadow = true;
        scene.add(rwyMesh);

        // 2. Đường lăn song song (Parallel Taxiway) & sân đỗ (Apron)
        const taxiMat = new THREE.MeshStandardMaterial({ color: 0x262d36, roughness: 0.84 });
        const taxiGeo = new THREE.PlaneGeometry(CONFIG.runwayLength - 120, 24);
        taxiGeo.rotateX(-Math.PI / 2);
        const taxiMesh = new THREE.Mesh(taxiGeo, taxiMat);
        taxiMesh.position.set(rx, y0 + 0.03, rz - 75);
        taxiMesh.receiveShadow = true;
        scene.add(taxiMesh);

        // Vạch vàng dẫn đường lăn
        const yellowLineMat = new THREE.MeshBasicMaterial({ color: 0xfacc15 });
        const lineGeo = new THREE.PlaneGeometry(CONFIG.runwayLength - 140, 0.7);
        lineGeo.rotateX(-Math.PI / 2);
        const taxiLine = new THREE.Mesh(lineGeo, yellowLineMat);
        taxiLine.position.set(rx, y0 + 0.06, rz - 75);
        scene.add(taxiLine);

        // Các đường lăn nối (Connecting Taxiways)
        for (let offset of [-580, -200, 200, 580]) {
            const connGeo = new THREE.PlaneGeometry(22, 65);
            connGeo.rotateX(-Math.PI / 2);
            const conn = new THREE.Mesh(connGeo, taxiMat);
            conn.position.set(rx + offset, y0 + 0.03, rz - 40);
            scene.add(conn);
        }

        // Sân đỗ máy bay (Apron)
        const apronGeo = new THREE.PlaneGeometry(580, 110);
        apronGeo.rotateX(-Math.PI / 2);
        const apron = new THREE.Mesh(apronGeo, taxiMat);
        apron.position.set(rx, y0 + 0.03, rz - 140);
        apron.receiveShadow = true;
        scene.add(apron);

        // 3. Nhà ga hành khách (Terminal Building)
        const termMat = new THREE.MeshStandardMaterial({ color: 0xcbd5e1, roughness: 0.35, metalness: 0.4 });
        const glassMat = new THREE.MeshStandardMaterial({
            color: 0x38bdf8,
            roughness: 0.15,
            metalness: 0.8,
            emissive: 0x0284c7,
            emissiveIntensity: 0.25
        });
        dynamicLightMaterials.push({ mat: glassMat, dayIntensity: 0.15, nightIntensity: 1.25 });

        const terminal = new THREE.Mesh(new THREE.BoxGeometry(240, 22, 46), termMat);
        terminal.position.set(rx - 40, y0 + 11, rz - 210);
        terminal.castShadow = true;
        terminal.receiveShadow = true;
        scene.add(terminal);
        colliders.push({ x: rx - 40, z: rz - 210, rx: 122, rz: 25, maxY: y0 + 23 });

        const termGlass = new THREE.Mesh(new THREE.BoxGeometry(230, 14, 48), glassMat);
        termGlass.position.set(rx - 40, y0 + 11, rz - 210);
        scene.add(termGlass);

        // 4. Tháp kiểm soát không lưu (ATC Control Tower) + Đèn xoay (Rotating Beacon)
        const towerX = rx + 135, towerZ = rz - 205;
        const towerShaft = new THREE.Mesh(new THREE.CylinderGeometry(6, 9, 58, 12), termMat);
        towerShaft.position.set(towerX, y0 + 29, towerZ);
        towerShaft.castShadow = true;
        scene.add(towerShaft);

        const towerCab = new THREE.Mesh(new THREE.CylinderGeometry(11, 8.5, 10, 12), glassMat);
        towerCab.position.set(towerX, y0 + 62, towerZ);
        scene.add(towerCab);

        const towerRoof = new THREE.Mesh(new THREE.CylinderGeometry(12, 11, 2.5, 12), termMat);
        towerRoof.position.set(towerX, y0 + 68, towerZ);
        scene.add(towerRoof);
        colliders.push({ x: towerX, z: towerZ, rx: 12, rz: 12, maxY: y0 + 74 });

        beaconHead = new THREE.Group();
        beaconHead.position.set(towerX, y0 + 71, towerZ);
        const coneGeo = new THREE.ConeGeometry(14, 90, 12, 1, true);
        coneGeo.rotateX(Math.PI / 2);
        coneGeo.translate(0, 0, 45);
        const coneMat = new THREE.MeshBasicMaterial({
            color: 0x34d399,
            transparent: true,
            opacity: 0.22,
            side: THREE.DoubleSide,
            blending: THREE.AdditiveBlending,
            depthWrite: false
        });
        beaconBeam = new THREE.Mesh(coneGeo, coneMat);
        beaconHead.add(beaconBeam);
        scene.add(beaconHead);

        // 5. Nhà chứa máy bay (Hangars)
        const hangarMat = new THREE.MeshStandardMaterial({ color: 0x64748b, roughness: 0.5, metalness: 0.5 });
        for (let i = 0; i < 3; i++) {
            const hx = rx - 250 - i * 75;
            const hz = rz - 195;
            const hBox = new THREE.Mesh(new THREE.BoxGeometry(52, 18, 46), hangarMat);
            hBox.position.set(hx, y0 + 9, hz);
            hBox.castShadow = true;
            scene.add(hBox);
            colliders.push({ x: hx, z: hz, rx: 27, rz: 24, maxY: y0 + 20 });
        }

        // 6. Cột gió (Animated Windsock) cạnh đường băng
        const pole = new THREE.Mesh(
            new THREE.CylinderGeometry(0.18, 0.22, 10, 8),
            new THREE.MeshStandardMaterial({ color: 0xe2e8f0 })
        );
        pole.position.set(rx - 520, y0 + 5, rz - 42);
        scene.add(pole);

        const sockGeo = new THREE.ConeGeometry(1.1, 5.5, 10, 3, true);
        sockGeo.rotateZ(Math.PI / 2);
        sockGeo.translate(2.7, 0, 0);
        const sockMat = new THREE.MeshStandardMaterial({
            color: 0xf97316,
