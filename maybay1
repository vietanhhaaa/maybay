    function createParkedPlaneMesh(colorHex) {
        const g = new THREE.Group();
        const mat = new THREE.MeshStandardMaterial({ color: colorHex, roughness: 0.35, metalness: 0.45 });
        const darkMat = new THREE.MeshStandardMaterial({ color: 0x1e293b, roughness: 0.5 });

        const body = new THREE.Mesh(new THREE.CylinderGeometry(1.4, 1.2, 22, 10), mat);
        body.rotation.z = Math.PI / 2;
        g.add(body);

        const wings = new THREE.Mesh(new THREE.BoxGeometry(4.2, 0.25, 24), mat);
        g.add(wings);

        const tail = new THREE.Mesh(new THREE.BoxGeometry(3.2, 4.5, 0.3), darkMat);
        tail.position.set(-9, 2.2, 0);
        g.add(tail);
        return g;
    }

