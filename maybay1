                dummy.updateMatrix();
                edgeInst.setMatrixAt(eIdx++, dummy.matrix);

                dummy.position.set(rx + x, y0 + 0.6, rz + CONFIG.runwayWidth / 2 + 1.2);
                dummy.updateMatrix();
                edgeInst.setMatrixAt(eIdx++, dummy.matrix);
