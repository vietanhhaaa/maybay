        const hlGeo = new THREE.BoxGeometry(2.2, 0.5, 5.2);
        const hlMat = new THREE.MeshBasicMaterial({ color: 0xfef08a });
        carHeadlightInst = new THREE.InstancedMesh(hlGeo, hlMat, carCount);

        const carColors = [0xef4444, 0x3b82f6, 0xfacc15, 0x10b981, 0xf8fafc, 0xa855f7, 0xf97316];
        for (let i = 0; i < carCount; i++) {
            const alongX = i % 2 === 0;
            const laneIndex = Math.floor(Math.random() * 13) - 6;
            const x = cx + (alongX ? (Math.random() - 0.5) * 960 : laneIndex * gridStep + 34);
            const z = cz + (alongX ? laneIndex * gridStep + 34 : (Math.random() - 0.5) * 960);
            const speed = (16 + Math.random() * 18) * (Math.random() > 0.5 ? 1 : -1);

            trafficCars.push({
                x,
                y: baseY + 0.85,
