<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no">
    <title>AERO-G: Mô Phỏng Bay 3D & Điều Khiển Trọng Lực</title>
    <style>
        :root {
            --hud-green: #00ffaa;
            --hud-cyan: #38bdf8;
            --hud-amber: #fbbf24;
            --hud-red: #fb7185;
            --panel-bg: rgba(8, 15, 28, 0.78);
            --panel-border: rgba(56, 189, 248, 0.35);
        }

        * {
            box-sizing: border-box;
            margin: 0;
            padding: 0;
            user-select: none;
            -webkit-user-select: none;
        }

        body, html {
            width: 100%;
            height: 100%;
            overflow: hidden;
            background: #030712;
            font-family: 'Segoe UI', system-ui, -apple-system, sans-serif;
            color: #e2e8f0;
        }

        #canvas-container {
            position: fixed;
            inset: 0;
            z-index: 1;
        }

        /* Hiệu ứng hậu kỳ màn hình: Vignette, Bloom Glow, G-Force / Gravity Tint */
        #post-fx-overlay {
            position: fixed;
            inset: 0;
            z-index: 2;
            pointer-events: none;
            background: radial-gradient(circle at center, transparent 58%, rgba(0, 4, 12, 0.62) 100%);
            transition: box-shadow 0.3s ease, background 0.3s ease;
        }

        #gravity-wave-fx {
            position: fixed;
            inset: 0;
            z-index: 3;
            pointer-events: none;
            opacity: 0;
            background: radial-gradient(circle at center, rgba(168, 85, 247, 0.28) 0%, transparent 70%);
            transition: opacity 0.45s ease;
        }

        #lens-flare-canvas {
            position: fixed;
            inset: 0;
            z-index: 4;
            pointer-events: none;
            width: 100%;
            height: 100%;
        }

        /* Giao diện HUD chính */
        #hud {
            position: fixed;
            inset: 0;
            z-index: 10;
            pointer-events: none;
            display: flex;
            flex-direction: column;
            justify-content: space-between;
            padding: 14px 18px;
        }

        .hud-interactive {
            pointer-events: auto;
        }

        /* Thanh trên cùng: La bàn + Thông số nhanh + Nút điều khiển */
        .hud-top {
            display: flex;
            justify-content: space-between;
            align-items: flex-start;
            gap: 12px;
        }

        .hud-card {
            background: var(--panel-bg);
            border: 1px solid var(--panel-border);
            backdrop-filter: blur(8px);
            border-radius: 10px;
            padding: 10px 14px;
            box-shadow: 0 8px 24px rgba(0, 0, 0, 0.45);
        }

        .top-left-stats {
            display: flex;
            flex-direction: column;
            gap: 6px;
            min-width: 225px;
        }

        .stat-row {
            display: flex;
            justify-content: space-between;
            align-items: center;
            font-size: 12px;
            letter-spacing: 0.4px;
        }

        .stat-label {
            color: #94a3b8;
            text-transform: uppercase;
            font-weight: 600;
        }

        .stat-val {
            font-family: 'Consolas', 'Courier New', monospace;
            font-weight: 700;
            font-size: 14px;
            color: var(--hud-green);
        }

        /* La bàn trên đỉnh */
        .compass-wrapper {
            display: flex;
            flex-direction: column;
            align-items: center;
            gap: 4px;
        }

        #compass-canvas {
            background: var(--panel-bg);
            border: 1px solid var(--panel-border);
            border-radius: 8px;
            box-shadow: 0 4px 16px rgba(0,0,0,0.4);
        }

        .top-right-controls {
            display: flex;
            flex-direction: column;
            align-items: flex-end;
            gap: 8px;
        }

        .btn-group {
            display: flex;
            gap: 6px;
            flex-wrap: wrap;
            justify-content: flex-end;
        }

        .hud-btn {
            background: rgba(15, 23, 42, 0.85);
            color: #e2e8f0;
            border: 1px solid rgba(56, 189, 248, 0.4);
            border-radius: 6px;
            padding: 6px 11px;
            font-size: 12px;
            font-weight: 600;
            cursor: pointer;
            transition: all 0.15s ease;
            display: inline-flex;
            align-items: center;
            gap: 5px;
        }

        .hud-btn:hover {
            background: rgba(56, 189, 248, 0.25);
            border-color: var(--hud-cyan);
            transform: translateY(-1px);
        }

        .hud-btn.active {
            background: rgba(0, 255, 170, 0.22);
            border-color: var(--hud-green);
            color: var(--hud-green);
        }

        /* Trung tâm màn hình: Đường chân trời nhân tạo (Artificial Horizon) */
        .hud-center {
            position: absolute;
            top: 50%;
            left: 50%;
            transform: translate(-50%, -50%);
            pointer-events: none;
            display: flex;
            align-items: center;
            justify-content: center;
        }

        #horizon-canvas {
            width: 380px;
            height: 320px;
        }

        /* Cảnh báo trung tâm (STALL, CRASH, PULL UP, TOUCHDOWN) */
        #hud-alert {
            position: absolute;
            top: 20%;
            left: 50%;
            transform: translateX(-50%);
            padding: 8px 22px;
            border-radius: 8px;
            font-weight: 800;
            font-size: 18px;
            letter-spacing: 2px;
            text-transform: uppercase;
            opacity: 0;
            transition: opacity 0.2s ease;
            pointer-events: none;
            text-align: center;
            z-index: 15;
        }

        #hud-alert.danger {
            background: rgba(225, 29, 72, 0.88);
            border: 2px solid #fda4af;
            color: #fff;
            box-shadow: 0 0 25px rgba(225, 29, 72, 0.8);
            animation: pulseAlert 0.45s infinite alternate;
        }

        #hud-alert.info {
            background: rgba(14, 116, 144, 0.88);
            border: 2px solid #67e8f9;
            color: #ecfeff;
            box-shadow: 0 0 20px rgba(6, 182, 212, 0.6);
        }

        @keyframes pulseAlert {
            from { transform: translateX(-50%) scale(0.97); }
            to { transform: translateX(-50%) scale(1.04); }
        }

        /* Phần dưới HUD: Đồng hồ bay, Trọng lực, Mini-map */
        .hud-bottom {
            display: flex;
            justify-content: space-between;
            align-items: flex-end;
            gap: 14px;
        }

        /* Cụm đồng hồ bên trái: Ga, Nhiên liệu, Trạng thái cơ giới */
        .flight-gauges {
            display: flex;
            gap: 14px;
            align-items: flex-end;
        }

        .vertical-bar-group {
            display: flex;
            gap: 10px;
            align-items: flex-end;
        }

        .v-bar-item {
            display: flex;
            flex-direction: column;
            align-items: center;
            gap: 4px;
        }

        .v-bar-track {
            width: 18px;
            height: 110px;
            background: rgba(15, 23, 42, 0.9);
            border: 1px solid rgba(148, 163, 184, 0.35);
            border-radius: 5px;
            overflow: hidden;
            display: flex;
            flex-direction: column;
            justify-content: flex-end;
            position: relative;
        }

        .v-bar-fill {
            width: 100%;
            transition: height 0.08s linear;
        }

        #throttle-fill {
            background: linear-gradient(to top, #10b981, #38bdf8, #f97316);
            height: 0%;
        }

        #fuel-fill {
            background: linear-gradient(to top, #f43f5e, #fbbf24, #22c55e);
            height: 100%;
        }

        .v-bar-label {
            font-size: 10px;
            font-weight: 700;
            color: #94a3b8;
        }

        .v-bar-val {
            font-size: 11px;
            font-family: 'Consolas', monospace;
            font-weight: 700;
            color: #f8fafc;
        }

        .systems-grid {
            display: grid;
            grid-template-columns: repeat(2, 1fr);
            gap: 6px;
            min-width: 190px;
        }

        .sys-pill {
            padding: 5px 8px;
            border-radius: 6px;
            font-size: 11px;
            font-weight: 700;
            background: rgba(15, 23, 42, 0.75);
            border: 1px solid rgba(148, 163, 184, 0.25);
            display: flex;
            justify-content: space-between;
            align-items: center;
        }

        .sys-pill span.on { color: var(--hud-green); }
        .sys-pill span.warn { color: var(--hud-amber); }
        .sys-pill span.off { color: #64748b; }

        /* Bảng điều khiển Trọng lực ở giữa dưới */
        .gravity-panel {
            min-width: 340px;
            max-width: 430px;
            display: flex;
            flex-direction: column;
            gap: 8px;
            border-color: rgba(168, 85, 247, 0.5);
            box-shadow: 0 8px 28px rgba(88, 28, 135, 0.35);
        }

        .gravity-header {
            display: flex;
            justify-content: space-between;
            align-items: center;
        }

        .gravity-title {
            font-size: 12px;
            font-weight: 800;
            text-transform: uppercase;
            letter-spacing: 0.8px;
            color: #d8b4fe;
            display: flex;
            align-items: center;
            gap: 6px;
        }

        .gravity-readout {
            font-family: 'Consolas', monospace;
            font-size: 15px;
            font-weight: 800;
            color: #f0abfc;
            background: rgba(88, 28, 135, 0.45);
            padding: 2px 8px;
            border-radius: 5px;
            border: 1px solid rgba(192, 132, 252, 0.4);
        }

        .gravity-slider-row {
            display: flex;
            align-items: center;
            gap: 8px;
        }

        #gravity-slider {
            flex: 1;
            accent-color: #c084fc;
            cursor: pointer;
            height: 6px;
        }

        .gravity-presets {
            display: grid;
            grid-template-columns: repeat(3, 1fr);
            gap: 5px;
        }

        .grav-btn {
            background: rgba(30, 17, 54, 0.85);
            border: 1px solid rgba(168, 85, 247, 0.35);
            color: #e9d5ff;
            font-size: 11px;
            font-weight: 600;
            padding: 5px 6px;
            border-radius: 5px;
            cursor: pointer;
            transition: all 0.15s ease;
            text-align: center;
        }

        .grav-btn:hover {
            background: rgba(147, 51, 234, 0.4);
            border-color: #d8b4fe;
        }

        .grav-btn.active {
            background: rgba(168, 85, 247, 0.55);
            border-color: #f0abfc;
            color: #ffffff;
            box-shadow: 0 0 12px rgba(168, 85, 247, 0.6);
        }

        /* Mini-map góc dưới phải */
        .minimap-card {
            display: flex;
            flex-direction: column;
            align-items: center;
            gap: 5px;
            padding: 8px;
        }

        #minimap-canvas {
            border-radius: 8px;
            border: 1px solid rgba(56, 189, 248, 0.45);
            background: #06121e;
        }

        .minimap-legend {
            display: flex;
            justify-content: space-between;
            width: 100%;
            font-size: 10px;
            color: #94a3b8;
        }

        /* Màn hình Bắt đầu / Tạm dừng Modal */
        #modal-overlay {
            position: fixed;
            inset: 0;
            z-index: 50;
            background: radial-gradient(circle at center, rgba(10, 18, 36, 0.84) 0%, rgba(2, 6, 16, 0.95) 100%);
            backdrop-filter: blur(10px);
            display: flex;
            align-items: center;
            justify-content: center;
            padding: 20px;
        }

        .modal-box {
            max-width: 820px;
            width: 100%;
            max-height: 92vh;
            overflow-y: auto;
            background: rgba(11, 20, 38, 0.94);
            border: 1px solid rgba(56, 189, 248, 0.45);
            border-radius: 16px;
            padding: 26px 30px;
            box-shadow: 0 24px 60px rgba(0, 0, 0, 0.75), 0 0 40px rgba(14, 165, 233, 0.2);
        }

        .modal-header {
            display: flex;
            justify-content: space-between;
            align-items: center;
            border-bottom: 1px solid rgba(148, 163, 184, 0.2);
            padding-bottom: 14px;
            margin-bottom: 18px;
        }

        .game-title {
            font-size: 26px;
            font-weight: 900;
            letter-spacing: 1px;
            background: linear-gradient(90deg, #38bdf8, #00ffaa, #c084fc);
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
        }

        .game-subtitle {
            font-size: 13px;
            color: #94a3b8;
            margin-top: 3px;
        }

        .modal-grid {
            display: grid;
            grid-template-columns: 1.2fr 1fr;
            gap: 18px;
            margin-bottom: 20px;
        }

        .info-section {
            background: rgba(15, 23, 42, 0.7);
            border: 1px solid rgba(148, 163, 184, 0.2);
            border-radius: 10px;
            padding: 14px;
        }

        .info-section h3 {
            font-size: 13px;
            text-transform: uppercase;
            letter-spacing: 0.7px;
            color: var(--hud-cyan);
            margin-bottom: 10px;
        }

        .key-list {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 7px 12px;
            font-size: 12px;
        }

        .key-item {
            display: flex;
            align-items: center;
            gap: 7px;
        }

        kbd {
            background: #1e293b;
            border: 1px solid #475569;
            border-bottom-width: 2px;
            border-radius: 4px;
            padding: 2px 6px;
            font-family: 'Consolas', monospace;
            font-size: 11px;
            font-weight: 700;
            color: #38bdf8;
            white-space: nowrap;
        }

        .settings-row {
            display: flex;
            justify-content: space-between;
            align-items: center;
            margin-bottom: 10px;
            font-size: 13px;
        }

        .modal-footer {
            display: flex;
            justify-content: space-between;
            align-items: center;
            gap: 12px;
            border-top: 1px solid rgba(148, 163, 184, 0.2);
            padding-top: 16px;
        }

        .start-btn {
            background: linear-gradient(135deg, #0284c7, #10b981);
            color: #fff;
            border: none;
            padding: 12px 32px;
            font-size: 16px;
            font-weight: 800;
            border-radius: 10px;
            cursor: pointer;
            letter-spacing: 0.8px;
            box-shadow: 0 8px 25px rgba(16, 185, 129, 0.4);
            transition: transform 0.15s ease, box-shadow 0.15s ease;
        }

        .start-btn:hover {
            transform: translateY(-2px);
            box-shadow: 0 12px 30px rgba(16, 185, 129, 0.6);
        }

        /* Điều khiển cảm ứng cho điện thoại / máy tính bảng */
        #touch-controls {
            position: fixed;
            inset: 0;
            z-index: 20;
            pointer-events: none;
            display: none;
        }

        #touch-controls.enabled {
            display: block;
        }

        .joystick-zone {
            position: absolute;
            bottom: 30px;
            left: 30px;
            width: 140px;
            height: 140px;
            border-radius: 50%;
            background: rgba(15, 23, 42, 0.55);
            border: 2px solid rgba(56, 189, 248, 0.5);
            pointer-events: auto;
            touch-action: none;
        }

        .joystick-knob {
            position: absolute;
            top: 50%;
            left: 50%;
            width: 52px;
            height: 52px;
            margin-left: -26px;
            margin-top: -26px;
            border-radius: 50%;
            background: radial-gradient(circle, #38bdf8, #0284c7);
            box-shadow: 0 0 15px rgba(56, 189, 248, 0.8);
        }

        .touch-right-pad {
            position: absolute;
            bottom: 30px;
            right: 220px;
            display: flex;
            flex-direction: column;
            gap: 8px;
            pointer-events: auto;
        }

        @media (max-width: 900px) {
            .modal-grid { grid-template-columns: 1fr; }
            .gravity-panel { min-width: 260px; }
            #horizon-canvas { width: 280px; height: 240px; }
            #touch-controls { display: block; }
        }
    </style>
</head>
<body>
    <!-- Container chứa cảnh 3D Three.js -->
    <div id="canvas-container"></div>

    <!-- Lớp phủ hậu kỳ: Vignette, G-Force / Gravity Tint & Lens Flare Mặt Trời -->
    <div id="post-fx-overlay"></div>
    <div id="gravity-wave-fx"></div>
    <canvas id="lens-flare-canvas"></canvas>

    <!-- Cảnh báo trung tâm (STALL, HẠ CÁNH, VA CHẠM) -->
    <div id="hud-alert">STALL - THẤT TỐC!</div>

    <!-- Giao diện HUD -->
    <div id="hud">
        <!-- Hàng trên cùng -->
        <div class="hud-top">
            <!-- Thông số bay chi tiết góc trái trên -->
            <div class="hud-card top-left-stats">
                <div class="stat-row">
                    <span class="stat-label">Tốc độ (IAS)</span>
                    <span class="stat-val" id="hud-speed">0 KT (0 km/h)</span>
                </div>
                <div class="stat-row">
                    <span class="stat-label">Độ cao (ALT)</span>
                    <span class="stat-val" id="hud-alt">0 m (0 ft)</span>
                </div>
                <div class="stat-row">
                    <span class="stat-label">Tốc độ đứng (V/S)</span>
                    <span class="stat-val" id="hud-vs">0.0 m/s</span>
                </div>
                <div class="stat-row">
                    <span class="stat-label">Góc tấn (AoA)</span>
                    <span class="stat-val" id="hud-aoa">0.0°</span>
                </div>
                <div class="stat-row">
                    <span class="stat-label">Chỉ số G-Force</span>
                    <span class="stat-val" id="hud-gforce">1.0 G</span>
                </div>
                <div class="stat-row">
                    <span class="stat-label">Đèn dẫn PAPI</span>
                    <span class="stat-val" id="hud-papi">⚪⚪🔴🔴 CHUẨN</span>
                </div>
            </div>

            <!-- La bàn chính giữa trên -->
            <div class="compass-wrapper">
                <canvas id="compass-canvas" width="320" height="44"></canvas>
                <div style="font-size: 11px; color: #94a3b8; background: rgba(8,15,28,0.75); padding: 2px 10px; border-radius: 10px; border: 1px solid rgba(56,189,248,0.25);">
                    <span id="hud-cam-mode">🎥 Camera: Sau lưng</span> &nbsp;|&nbsp;
                    <span id="hud-time-label">☀️ Ban ngày (14:00)</span> &nbsp;|&nbsp;
                    <span id="hud-fps">60 FPS</span>
                </div>
            </div>

            <!-- Cụm nút nhanh góc phải trên -->
            <div class="hud-card top-right-controls hud-interactive">
                <div class="btn-group">
                    <button class="hud-btn" id="btn-time" title="Phím N: Đổi Ngày / Hoàng hôn / Đêm">🌗 Ngày/Đêm (N)</button>
                    <button class="hud-btn" id="btn-camera" title="Phím C: Đổi góc nhìn">🎥 Camera (C)</button>
                    <button class="hud-btn" id="btn-mouse-steer" title="Phím M: Bật/tắt lái bằng chuột">🖱️ Lái chuột (M)</button>
                </div>
                <div class="btn-group">
                    <button class="hud-btn" id="btn-quality" title="Đổi chất lượng đồ họa">✨ Đồ họa: Cao</button>
                    <button class="hud-btn" id="btn-audio" title="Bật/tắt âm thanh động cơ">🔊 Âm thanh: Bật</button>
                    <button class="hud-btn" id="btn-respawn" title="Phím R: Đưa máy bay về đầu đường băng">🛫 Sân bay (R)</button>
                    <button class="hud-btn" id="btn-pause" title="Phím P: Tạm dừng & Hướng dẫn">⏸️ Menu (P)</button>
                </div>
            </div>
        </div>

        <!-- Đường chân trời nhân tạo (Artificial Horizon) chính giữa -->
        <div class="hud-center">
            <canvas id="horizon-canvas" width="380" height="320"></canvas>
        </div>

        <!-- Hàng dưới cùng -->
        <div class="hud-bottom">
            <!-- Thanh Ga, Nhiên liệu & Trạng thái hệ thống -->
            <div class="hud-card flight-gauges">
                <div class="vertical-bar-group">
                    <div class="v-bar-item">
                        <span class="v-bar-val" id="hud-thr-val">0%</span>
                        <div class="v-bar-track">
                            <div class="v-bar-fill" id="throttle-fill"></div>
                        </div>
                        <span class="v-bar-label">GA (THR)</span>
                    </div>
                    <div class="v-bar-item">
                        <span class="v-bar-val" id="hud-fuel-val">100%</span>
                        <div class="v-bar-track">
                            <div class="v-bar-fill" id="fuel-fill"></div>
                        </div>
                        <span class="v-bar-label">NHIÊN LIỆU</span>
                    </div>
                </div>

                <div class="systems-grid">
                    <div class="sys-pill">
                        <span>BÁNH ĐÁP (G)</span>
                        <span id="sys-gear" class="on">HẠ (DOWN)</span>
                    </div>
                    <div class="sys-pill">
                        <span>FLAPS (F)</span>
                        <span id="sys-flaps" class="off">0°</span>
                    </div>
                    <div class="sys-pill">
                        <span>PHANH (SPACE)</span>
                        <span id="sys-brake" class="off">NHẢ</span>
                    </div>
                    <div class="sys-pill">
                        <span>ĐỘNG CƠ (AB)</span>
                        <span id="sys-ab" class="off">BÌNH THƯỜNG</span>
                    </div>
                    <div class="sys-pill" style="grid-column: span 2;">
                        <span>TRẠNG THÁI BAY</span>
                        <span id="sys-flight-state" class="on">ĐỖ ĐƯỜNG BĂNG 09</span>
                    </div>
                </div>
            </div>

            <!-- Điều khiển Trọng lực (Tính năng đặc biệt) -->
            <div class="hud-card gravity-panel hud-interactive">
                <div class="gravity-header">
                    <span class="gravity-title">🌌 ĐIỀU KHIỂN TRỌNG LỰC ([ / ])</span>
                    <span class="gravity-readout" id="gravity-readout">1.00 g (Trái Đất)</span>
                </div>
                <div class="gravity-slider-row">
                    <span style="font-size:11px; color:#c084fc;">-1g</span>
                    <input type="range" id="gravity-slider" min="-1" max="3" step="0.01" value="1">
